  :global(.badge.wait) { background: var(--bg-warm); color: #8a6400; }
  :global(.badge.off) { background: #eeeae4; color: var(--muted); }
  :global(.code-txt) { font-family: ui-monospace, 'SFMono-Regular', Consolas, monospace; font-weight: 700; letter-spacing: 0.04em; }

  .proj-bar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 0.75rem; }
  .proj-bar p { margin: 0; }
  :global(.item .p-thumb) { width: 64px; height: 48px; border-radius: 10px; object-fit: cover; background: var(--panel-2); flex: none; }
  :global(.item .p-row) { display: flex; gap: 0.9rem; align-items: center; }
  :global(.item .p-row h3) { font-size: 1.05rem; margin: 0; }

  .pdlg { border: 0; padding: 0; width: min(100% - 24px, 620px); max-height: calc(100dvh - 24px); border-radius: 28px; background: var(--panel); }
  .pdlg::backdrop { background: rgb(21 21 21 / 0.55); }
  .pform { padding: 1.5rem; display: grid; gap: 1rem; }
  .pform-head { display: flex; justify-content: space-between; align-items: center; }
  .pform-head h2 { margin: 0; font-size: 1.5rem; }
  .pform .round--light { background: var(--panel-2); }
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; }
  .img-row { display: flex; gap: 1rem; align-items: center; }
  .thumb { width: 120px; height: 80px; border-radius: 14px; background: var(--panel-2); display: grid; place-items: center; color: var(--muted); overflow: hidden; flex: none; }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .img-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .file-btn { cursor: pointer; border: 1.5px solid var(--line); }
  .check { display: flex; gap: 0.6rem; align-items: center; font-weight: 600; }
  .check input { width: 20px; height: 20px; accent-color: var(--ink); }
  .pform-foot { display: flex; justify-content: flex-end; gap: 0.5rem; padding-top: 0.5rem; }
  @media (max-width: 520px) { .row2 { grid-template-columns: 1fr; } .msec .row2 { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 340px) { .msec .row2 { grid-template-columns: 1fr; } }

  .hint { font-size: 0.82rem; color: var(--muted); }
  .link-row .btn--light { border: 1.5px solid var(--line); }
  .mono-up { font-family: ui-monospace, 'SFMono-Regular', Consolas, monospace; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 700; }
  .fs { border: 0; padding: 0; margin: 0; min-width: 0; }
  .fs legend { padding: 0; margin-bottom: 0.45rem; }
  .seg3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; padding: 4px; border-radius: 16px; background: var(--panel-2); }
  .seg3 label { position: relative; display: grid; place-items: center; min-height: 42px; border-radius: 12px; font-weight: 600; font-size: 0.92rem; cursor: pointer; text-align: center; }
  .seg3 input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .seg3 label:has(input:checked) { background: var(--ink); color: #fff; }
  .seg3 label:has(input:focus-visible) { outline: 3px solid var(--brand-deep); outline-offset: 2px; }
  .svc-checks { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; }
  .svc-checks .check { font-weight: 500; }
  [data-max-wrap][hidden], [data-personal-wrap][hidden], [data-quota-wrap][hidden] { display: none; }
  .preview { margin: 0; padding: 0.85rem 1rem; border-radius: 14px; background: #fff3d1; font-size: 0.88rem; display: grid; gap: 0.25rem; }
  .preview:empty { display: none; }
  .preview :global(strong) { font-family: var(--font-head); font-size: 0.98rem; }
  .preview :global(ul) { margin: 0; padding-left: 1.1rem; display: grid; gap: 0.15rem; }

  .mdlg { width: min(100% - 24px, 1180px); }
  .mform { gap: 1rem; padding-bottom: 0; padding-top: 1.25rem; }
  .mform .pform-head h2 { font-size: 1.35rem; }
  .mform .field { gap: 0.3rem; }
  .mform .input, .mform .select { min-height: 44px; padding-block: 0.5rem; }
  .mform .seg3 label { min-height: 38px; }
  .mform .days label { min-height: 36px; }
  .mform .hint { font-size: 0.78rem; }
  .mform .pform-head { align-items: flex-start; gap: 1rem; }
  .mform .sub { margin: 0.25rem 0 0; }
  .mcols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 1.5rem; align-items: start; }
  .mcol { display: grid; gap: 1rem; min-width: 0; }
  .mform .msec { gap: 0.7rem; }
  .mcol .msec:first-child { border-top: 0; padding-top: 0; }
  .mfoot {
    position: sticky; bottom: 0; z-index: 2; display: grid; grid-template-columns: 1fr auto; gap: 1rem; align-items: end;
    margin-inline: -1.5rem; padding: 1rem 1.5rem 1.25rem; background: var(--panel); border-top: 1px solid var(--line);
  }
  .mfoot { padding-block: 0.85rem 1rem; }
  .mfoot .preview { gap: 0.15rem; padding: 0.65rem 0.9rem; font-size: 0.85rem; max-height: 4.6rem; overflow: auto; }
  .mfoot .preview :global(strong) { font-size: 0.95rem; }
  .mfoot-r { display: grid; gap: 0.5rem; justify-items: end; }
  .mfoot-r .error { margin: 0; text-align: right; max-width: 34ch; }
  .mfoot .pform-foot { padding-top: 0; }
  @media (max-width: 1100px) {
    .mcols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .mcol:nth-child(3) .msec:first-child { border-top: 1px solid var(--line); padding-top: 1rem; margin-top: 1rem; }
  }
  @media (max-width: 820px) {
    .mcols { grid-template-columns: 1fr; }
    .mcol + .mcol .msec:first-child { border-top: 1px solid var(--line); padding-top: 1rem; margin-top: 1rem; }
    .mfoot { grid-template-columns: 1fr; }
    .mfoot-r { justify-items: stretch; }
    .mfoot-r .error { text-align: left; max-width: none; }
    .mfoot .preview { max-height: 6.5rem; }
  }
  .msec { display: grid; gap: 0.85rem; padding-top: 1rem; border-top: 1px solid var(--line); }
  .msec h3 { margin: 0; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); font-family: var(--font-body); }
  .msec .row2 { grid-template-columns: 1fr 1fr; }
  .span2 { grid-column: 1 / -1; }
  [data-hours-wrap][hidden], [data-ppl-wrap][hidden], [data-mode-wrap][hidden] { display: none; }
  .quick { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.15rem; }
  .quick button {
    border: 1px solid var(--line); background: #fff; border-radius: 99px; padding: 0.25rem 0.7rem; font-size: 0.8rem; font-weight: 600;
    cursor: pointer; min-height: 32px; color: var(--ink-2);
  }
  .quick button:hover { border-color: var(--ink); color: var(--ink); }
  .days { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; padding: 4px; border-radius: 14px; background: var(--panel-2); }
  .days label { position: relative; display: grid; place-items: center; min-height: 40px; border-radius: 10px; font-weight: 650; font-size: 0.82rem; cursor: pointer; }
  .days input { position: absolute; inset: 0; opacity: 0; cursor: pointer; margin: 0; }
  .days label:has(input:checked) { background: var(--ink); color: #fff; }
  .days label:has(input:focus-visible) { outline: 3px solid var(--brand-deep); outline-offset: 2px; }
  :global(.i-cond) { font-size: 0.86rem; color: var(--ink-2); display: flex; flex-wrap: wrap; gap: 0.3rem; }
  :global(.i-cond span) { border: 1px solid var(--line); border-radius: 99px; padding: 0.1rem 0.6rem; background: #fff; }
  :global(.item.is-editing) { outline: 2px solid var(--ink); outline-offset: 2px; }
  :global(.promo-code) { font-family: ui-monospace, 'SFMono-Regular', Consolas, monospace; font-weight: 800; font-size: 1.1rem; letter-spacing: 0.05em; }
  :global(.uses) { display: grid; gap: 0.35rem; padding: 0.75rem; border-radius: 14px; background: var(--panel-2); font-size: 0.88rem; }
  :global(.uses .u) { display: flex; justify-content: space-between; gap: 0.75rem; align-items: center; flex-wrap: wrap; }
  :global(.uses .u.cancel) { color: var(--muted); text-decoration: line-through; }
  :global(.uses button) { border: 1px solid var(--line); background: #fff; border-radius: 99px; padding: 0.2rem 0.65rem; font-size: 0.8rem; font-weight: 600; cursor: pointer; text-decoration: none; }

  .or-search { max-width: 240px; min-height: 40px; padding-block: 0.4rem; font-size: 0.92rem; }
  .or-help { margin: 0 0 0.75rem; }
  :global(.badge.run) { background: #e3ecff; color: #2747a8; }
  :global(.o-code) { font-family: ui-monospace, 'SFMono-Regular', Consolas, monospace; font-weight: 800; font-size: 1.02rem; letter-spacing: 0.02em; }
  :global(.o-extra) { display: flex; flex-wrap: wrap; gap: 0.3rem; font-size: 0.82rem; }
  :global(.o-extra span) { border: 1px solid var(--line); border-radius: 99px; padding: 0.1rem 0.6rem; }
  :global(.o-edit) { display: grid; grid-template-columns: 1fr 1fr auto; gap: 0.5rem; align-items: end; padding: 0.75rem; border-radius: 14px; background: var(--panel-2); }
  :global(.o-edit label) { display: grid; gap: 0.25rem; font-size: 0.8rem; font-weight: 650; color: var(--muted); }
  :global(.o-edit .input), :global(.o-edit .select) { min-height: 40px; padding-block: 0.35rem; font-size: 0.92rem; background-color: #fff; }
  :global(.o-edit .note) { grid-column: 1 / -1; }
  :global(.o-edit button) { min-height: 40px; }
  :global(.o-flag) { font-size: 0.82rem; font-weight: 650; color: var(--ok); }
  @media (max-width: 560px) { :global(.o-edit) { grid-template-columns: 1fr 1fr; } :global(.o-edit button) { grid-column: 1 / -1; } }
  .fb-filter { display: flex; gap: 0.3rem; flex-wrap: wrap; }
  .fb-filter button { border: 1px solid var(--line); background: #fff; border-radius: 99px; padding: 0.3rem 0.8rem; font-size: 0.85rem; font-weight: 600; cursor: pointer; min-height: 34px; }
  .fb-filter button[aria-pressed='true'] { background: var(--ink); color: #fff; border-color: var(--ink); }

  .pass-wrap { position: relative; }
  .pass-wrap .input { padding-right: 3.4rem; }
  .eye {
    position: absolute; right: 6px; top: 50%; translate: 0 -50%; width: 40px; height: 40px; border: 0; border-radius: 12px;
    background: transparent; color: var(--muted); display: grid; place-items: center; cursor: pointer;
  }
  .eye:hover { background: var(--panel-2); color: var(--ink); }
  .eye .eye-hide, .eye[aria-pressed='true'] .eye-show { display: none; }
  .eye[aria-pressed='true'] .eye-hide { display: grid; }
  .eye .eye-show { display: grid; }

  .toast {
    position: fixed; left: 50%; bottom: calc(1.25rem + env(safe-area-inset-bottom)); translate: -50% 20px; opacity: 0; pointer-events: none;
    background: var(--ink); color: #fff; padding: 0.7rem 1.1rem; border-radius: 12px; font-weight: 600; font-size: 0.92rem;
    box-shadow: var(--shadow-lg); transition: opacity 0.2s ease, translate 0.2s ease; max-width: calc(100% - 2rem); z-index: 60;
  }
  .toast.on { opacity: 1; translate: -50% 0; }
  .toast.err { background: var(--err); }

  @media (max-width: 980px) {
    .grid { grid-template-columns: 1fr; }
    .new { position: static; }
    .stats { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
  import { orders as orderApi, type AdminOrder } from '../lib/admin';
  import { api, projects as projApi, promos as promoApi, uploadImage, getSession, login, logout, AuthError, type Code, type AdminReview, type AdminProject, type AdminPromo, type PromoUse } from '../lib/admin';
  import { SITE, SERVICES } from '../config';
  import { promoLabel, daysLabel, timeLabel, rupiah } from '../lib/supabase';
  import { feedback as fbApi, type Feedback } from '../lib/admin';

  const $ = <T extends Element>(s: string) => document.querySelector<T>(s)!;
  const views = ['login', 'loading', 'denied', 'dash'] as const;
  const show = (v: (typeof views)[number]) =>
    views.forEach((x) => ($(`[data-view="${x}"]`) as HTMLElement).toggleAttribute('hidden', x !== v));

  let toastTimer: number | undefined;
  const toast = (msg: string, err = false) => {
    const t = $<HTMLElement>('[data-toast]');
    t.textContent = msg;
    t.classList.toggle('err', err);
    t.classList.add('on');
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => t.classList.remove('on'), 2600);
  };

  const reviewLink = (code: string) => `${SITE.url}/ulasan?kode=${encodeURIComponent(code)}`;
  const waShare = (code: string, name?: string | null) =>
    `https://wa.me/?text=${encodeURIComponent(
      `Halo${name ? ' Kak ' + name : ''}, terima kasih sudah memakai layanan PAS!\n\nBoleh minta waktunya sebentar untuk memberi ulasan? Cukup buka link ini:\n${reviewLink(code)}\n\nKode ulasan: ${code}`,
    )}`;
  const fmtDate = (iso: string) =>
    new Date(iso).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
  const copy = async (text: string) => {
    try { await navigator.clipboard.writeText(text); toast('Link disalin.'); }
    catch { toast('Gagal menyalin. Salin manual dari kolom link.', true); }
  };

  const handle = (e: unknown) => {
    if (e instanceof AuthError) { show('login'); $('[data-login-status]').textContent = e.message; return; }
    console.error(e);
    toast(e instanceof Error ? e.message : 'Terjadi kesalahan.', true);
  };

  // ---------- render ----------
  let codes: Code[] = [];
  let reviews: AdminReview[] = [];
  let projs: AdminProject[] = [];
  let promoList: AdminPromo[] = [];
  let promoUses: PromoUse[] = [];
  const openUses = new Set<string>();
  let fbList: Feedback[] = [];
  let fbFilter = '';
  let orderList: AdminOrder[] = [];
  let orFilter = '', orQuery = '';
  const isPending = (r: AdminReview) => !r.is_visible && !r.approved_at;

  const el = (tag: string, cls?: string, text?: string) => {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text !== undefined) n.textContent = text;
    return n;
  };
  const btn = (label: string, onClick: () => void, cls = '') => {
    const b = el('button', cls, label) as HTMLButtonElement;
    b.type = 'button';
    b.addEventListener('click', onClick);
    return b;
  };

  function renderStats() {
    const vis = reviews.filter((r) => r.is_visible);
    const avg = vis.length ? vis.reduce((a, r) => a + r.rating, 0) / vis.length : 0;
    $('[data-s-avg]').textContent = vis.length ? `${avg.toFixed(1).replace('.', ',')} ★` : '0';
    $('[data-s-visible]').textContent = String(vis.length);
    $('[data-s-hidden]').textContent = String(reviews.filter(isPending).length);
    $('[data-s-open]').textContent = String(orderList.filter((o) => o.status === 'menunggu' || o.status === 'dikerjakan').length);
    $('[data-c-orders]').textContent = String(orderList.filter((o) => o.status === 'menunggu').length || orderList.length);
    $('[data-c-reviews]').textContent = String(reviews.length);
    $('[data-c-codes]').textContent = String(codes.length);
    $('[data-c-projects]').textContent = String(projs.length);
    $('[data-c-promos]').textContent = String(promoList.length);
    $('[data-c-feedback]').textContent = String(fbList.filter((f) => f.status === 'baru').length);
  }

  function renderReviews() {
    const box = $<HTMLElement>('[data-reviews]');
    box.innerHTML = '';
    $('[data-reviews-empty]').toggleAttribute('hidden', reviews.length > 0);
    const sorted = [...reviews].sort((a, b) => Number(isPending(b)) - Number(isPending(a)));
    for (const r of sorted) {
      const pending = isPending(r);
      const it = el('article', `item${r.is_visible || pending ? '' : ' is-hidden'}`);
      const head = el('div', 'i-head');
      const stars = el('span', '', '★★★★★'.slice(0, r.rating) + '☆☆☆☆☆'.slice(0, 5 - r.rating));
      stars.style.color = 'var(--star)';
      stars.style.letterSpacing = '2px';
      stars.setAttribute('aria-label', `${r.rating} dari 5 bintang`);
      head.append(stars, el('span', `badge ${pending ? 'wait' : r.is_visible ? 'ok' : 'off'}`, pending ? 'Menunggu dicek' : r.is_visible ? 'Tampil' : 'Disembunyikan'));
      const meta = el('div', 'i-meta');
      meta.append(el('strong', '', r.name), el('span', '', r.service), el('span', '', fmtDate(r.created_at)));
      if (r.source === 'struk') meta.append(el('span', 'o-flag', 'Pembeli terverifikasi'), el('span', 'code-txt', r.order_code ?? 'struk dihapus'));
      else meta.append(el('span', 'code-txt', r.code ?? ''));
      const setVis = (v: boolean) => async () => {
        try {
          await api.setVisible(r.id, v);
          r.is_visible = v; r.approved_at = new Date().toISOString();
          renderReviews(); renderStats();
          toast(v ? 'Ulasan ditampilkan.' : 'Ulasan disembunyikan.');
        } catch (e) { handle(e); }
      };
      const actions = el('div', 'i-actions');
      if (pending) actions.append(btn('Setujui & tampilkan', setVis(true)), btn('Tolak (sembunyikan)', setVis(false)));
      else actions.append(btn(r.is_visible ? 'Sembunyikan' : 'Tampilkan', setVis(!r.is_visible)));
      actions.append(
        btn('Hapus', async () => {
          if (!confirm(`Hapus ulasan dari ${r.name}? Tindakan ini tidak bisa dibatalkan.`)) return;
          try {
            await api.deleteReview(r.id);
            reviews = reviews.filter((x) => x.id !== r.id);
            renderReviews(); renderStats();
            toast('Ulasan dihapus.');
          } catch (e) { handle(e); }
        }, 'danger'),
      );
      it.append(head, meta, el('p', 'i-txt', r.comment), actions);
      box.append(it);
    }
  }

  function renderCodes() {
    const box = $<HTMLElement>('[data-codes]');
    box.innerHTML = '';
    $('[data-codes-empty]').toggleAttribute('hidden', codes.length > 0);
    for (const c of codes) {
      const it = el('article', 'item');
      const head = el('div', 'i-head');
      head.append(el('span', 'code-txt', c.code), el('span', `badge ${c.used_at ? 'ok' : 'wait'}`, c.used_at ? `Dipakai ${fmtDate(c.used_at)}` : 'Belum dipakai'));
      const meta = el('div', 'i-meta');
      meta.append(el('strong', '', c.client_name || 'Tanpa nama'), el('span', '', c.service || 'Tanpa layanan'), el('span', '', `Dibuat ${fmtDate(c.created_at)}`));
      if (c.note) meta.append(el('span', '', c.note));
      const actions = el('div', 'i-actions');
      if (!c.used_at) {
        const wa = el('a', '', 'WhatsApp') as HTMLAnchorElement;
        wa.href = waShare(c.code, c.client_name);
        wa.target = '_blank';
        wa.rel = 'noopener';
        actions.append(
          btn('Salin link', () => copy(reviewLink(c.code))),
          wa,
          btn('Hapus', async () => {
            if (!confirm(`Hapus kode ${c.code}?`)) return;
            try {
              await api.deleteCode(c.code);
              codes = codes.filter((x) => x.code !== c.code);
              renderCodes(); renderStats();
              toast('Kode dihapus.');
            } catch (e) { handle(e); }
          }, 'danger'),
        );
      }
      it.append(head, meta);
      if (actions.childElementCount) it.append(actions);
      box.append(it);
    }
  }

  function renderProjects() {
    const box = $<HTMLElement>('[data-projects]');
    box.innerHTML = '';
    $('[data-projects-empty]').toggleAttribute('hidden', projs.length > 0);
    for (const p of projs) {
      const it = el('article', `item${p.is_published ? '' : ' is-hidden'}`);
      const row = el('div', 'p-row');
      if (p.image_url) {
        const img = document.createElement('img');
        img.className = 'p-thumb'; img.src = p.image_url; img.alt = ''; img.loading = 'lazy';
        row.append(img);
      }
      const t = el('div');
      t.append(el('h3', '', p.title));
      const meta = el('div', 'i-meta');
      meta.append(el('span', 'tag', p.category));
      if (p.year) meta.append(el('span', '', String(p.year)));
      if (p.client) meta.append(el('span', '', p.client));
      meta.append(el('span', '', `urutan ${p.sort_order}`));
      t.append(meta);
      row.append(t);
      const head = el('div', 'i-head');
      head.append(row, el('span', `badge ${p.is_published ? 'ok' : 'off'}`, p.is_published ? 'Tampil' : 'Disembunyikan'));
      const actions = el('div', 'i-actions');
      actions.append(
        btn('Edit', () => openProject(p)),
        btn(p.is_published ? 'Sembunyikan' : 'Tampilkan', async () => {
          try {
            await projApi.update(p.id, { is_published: !p.is_published });
            p.is_published = !p.is_published;
            renderProjects();
            toast(p.is_published ? 'Karya ditampilkan.' : 'Karya disembunyikan.');
          } catch (e) { handle(e); }
        }),
        btn('Hapus', async () => {
          if (!confirm(`Hapus karya "${p.title}"? Tindakan ini tidak bisa dibatalkan.`)) return;
          try {
            await projApi.remove(p.id);
            projs = projs.filter((x) => x.id !== p.id);
            renderProjects(); renderStats();
            toast('Karya dihapus.');
          } catch (e) { handle(e); }
        }, 'danger'),
      );
      it.append(head);
      if (p.summary) it.append(el('p', 'i-txt', p.summary));
      it.append(actions);
      box.append(it);
    }
  }

  // ---------- dialog karya ----------
  const dlg = $<HTMLDialogElement>('[data-pdlg]');
  const pf = $<HTMLFormElement>('#project-form');
  const f = {
    title: $<HTMLInputElement>('#p-title'), cat: $<HTMLSelectElement>('#p-cat'), year: $<HTMLInputElement>('#p-year'),
    client: $<HTMLInputElement>('#p-client'), order: $<HTMLInputElement>('#p-order'), summary: $<HTMLTextAreaElement>('#p-summary'),
    tech: $<HTMLInputElement>('#p-tech'), url: $<HTMLInputElement>('#p-url'), pub: $<HTMLInputElement>('#p-pub'),
    file: $<HTMLInputElement>('[data-file]'),
  };
  const thumb = $<HTMLElement>('[data-thumb]');
  const thumbEmpty = thumb.innerHTML;
  const imgRemove = $<HTMLButtonElement>('[data-img-remove]');
  const perr = $<HTMLElement>('[data-pform-err]');
  let editing: AdminProject | null = null;
  let imageUrl: string | null = null;
  let pendingFile: File | null = null;

  const setThumb = (src: string | null) => {
    thumb.innerHTML = '';
    if (src) { const i = document.createElement('img'); i.src = src; i.alt = ''; thumb.append(i); } else thumb.innerHTML = thumbEmpty;
    imgRemove.hidden = !src;
  };

  function openProject(p: AdminProject | null) {
    editing = p;
    pendingFile = null;
    perr.hidden = true;
    $('[data-pdlg-title]').textContent = p ? 'Edit karya' : 'Tambah karya';
    f.title.value = p?.title ?? '';
    f.cat.value = p?.category ?? 'Website';
    f.year.value = p?.year ? String(p.year) : String(new Date().getFullYear());
    f.client.value = p?.client ?? '';
    f.order.value = String(p?.sort_order ?? 0);
    f.summary.value = p?.summary ?? '';
    f.tech.value = (p?.tech ?? []).join(', ');
    f.url.value = p?.url ?? '';
    f.pub.checked = p?.is_published ?? true;
    f.file.value = '';
    imageUrl = p?.image_url ?? null;
    setThumb(imageUrl);
    dlg.showModal();
    f.title.focus();
  }

  $('[data-add-project]').addEventListener('click', () => openProject(null));
  document.querySelectorAll('[data-pdlg-close]').forEach((b) => b.addEventListener('click', () => dlg.close()));
  f.file.addEventListener('change', () => {
    const file = f.file.files?.[0];
    if (!file) return;
    pendingFile = file;
    setThumb(URL.createObjectURL(file));
  });
  imgRemove.addEventListener('click', () => { pendingFile = null; imageUrl = null; f.file.value = ''; setThumb(null); });

  pf.addEventListener('submit', async (e) => {
    e.preventDefault();
    perr.hidden = true;
    const title = f.title.value.trim();
    const url = f.url.value.trim();
    const year = f.year.value ? Number(f.year.value) : null;
    const problem =
      title.length < 2 ? 'Judul minimal 2 karakter.' :
      url && !/^https?:\/\//i.test(url) ? 'Link harus diawali https://' :
      year !== null && (year < 2015 || year > 2100) ? 'Tahun tidak valid.' : '';
    if (problem) { perr.textContent = problem; perr.hidden = false; return; }
    const save = $<HTMLButtonElement>('[data-psave]');
    save.disabled = true; save.textContent = pendingFile ? 'Mengunggah…' : 'Menyimpan…';
    try {
      if (pendingFile) imageUrl = await uploadImage(pendingFile);
      const data = {
        title, category: f.cat.value as AdminProject['category'], year,
        client: f.client.value.trim() || null, sort_order: Number(f.order.value) || 0,
        summary: f.summary.value.trim() || null,
        tech: f.tech.value.split(',').map((x) => x.trim()).filter(Boolean).slice(0, 12),
        url: url || null, image_url: imageUrl, is_published: f.pub.checked,
      };
      if (editing) await projApi.update(editing.id, data); else await projApi.create(data);
      projs = await projApi.list();
      renderProjects(); renderStats();
      dlg.close();
      toast(editing ? 'Karya diperbarui.' : 'Karya ditambahkan.');
    } catch (err) {
      if (err instanceof AuthError) { dlg.close(); handle(err); return; }
      perr.textContent = err instanceof Error ? err.message : 'Gagal menyimpan.';
      perr.hidden = false;
    } finally {
      save.disabled = false; save.textContent = 'Simpan';
    }
  });

  // ---------- promo ----------
  const svcShort = (id: string) => SERVICES.find((s) => s.id === id)?.short ?? id;
  const fmtDT = (iso: string) => new Date(iso).toLocaleString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  const usedCount = (code: string) => promoUses.filter((u) => u.code === code && u.status === 'used').length;
  function promoState(p: AdminPromo): [string, string] {
    const now = Date.now();
    if (!p.is_active) return ['Nonaktif', 'off'];
    if (p.starts_at && now < Date.parse(p.starts_at)) return ['Terjadwal', 'wait'];
    if (p.ends_at && now > Date.parse(p.ends_at)) return ['Berakhir', 'off'];
    if (p.quota !== null && usedCount(p.code) >= p.quota) return [p.personal_for ? 'Sudah dipakai' : 'Kuota habis', 'off'];
    if (!inSchedule(p)) return ['Di luar jadwal', 'wait'];
    return ['Aktif', 'ok'];
  }
  /** Cek hari & jam sekarang (WIB) terhadap jadwal promo. */
  function inSchedule(p: AdminPromo) {
    const parts = Object.fromEntries(
      new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Jakarta', weekday: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' })
        .formatToParts(new Date()).map((x) => [x.type, x.value]),
    );
    const dow = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'].indexOf(parts.weekday) + 1;
    if (p.days?.length && !p.days.includes(dow)) return false;
    if (p.time_start && p.time_end) {
      const t = `${parts.hour}:${parts.minute}`, a = p.time_start.slice(0, 5), b = p.time_end.slice(0, 5);
      return a < b ? t >= a && t < b : t >= a || t < b;
    }
    return true;
  }

  function renderPromos() {
    const box = $<HTMLElement>('[data-promos]');
    box.innerHTML = '';
    $('[data-promos-empty]').toggleAttribute('hidden', promoList.length > 0);
    for (const p of promoList) {
      const [label, cls] = promoState(p);
      const it = el('article', `item${cls === 'off' ? ' is-hidden' : ''}${editingPromo?.code === p.code ? ' is-editing' : ''}`);
      const head = el('div', 'i-head');
      const left = el('div');
      left.append(el('div', 'promo-code', p.code));
      left.append(el('div', '', `${promoLabel(p)}${p.title ? ' · ' + p.title : ''}`));
      head.append(left, el('span', `badge ${cls}`, label));
      const meta = el('div', 'i-meta');
      meta.append(el('strong', '', `Dipakai ${usedCount(p.code)}${p.quota !== null ? ' / ' + p.quota : ''}`));
      if (p.starts_at || p.ends_at) meta.append(el('span', '', `${p.starts_at ? fmtDT(p.starts_at) : 'Sekarang'} sampai ${p.ends_at ? fmtDT(p.ends_at) : 'tanpa batas'}`));
      if (p.note) meta.append(el('span', '', p.note));
      const conds = [
        p.services.length ? p.services.map(svcShort).join(', ') : 'Semua layanan',
        daysLabel(p.days), timeLabel(p.time_start, p.time_end),
        p.class_mode ? `Kelas ${p.class_mode.toLowerCase()}` : '',
        p.per_person_limit ? `Maks. ${p.per_person_limit}x per orang` : '',
        p.personal_for ? `Khusus ${p.personal_for}` : '',
      ].filter(Boolean);
      const cond = el('div', 'i-cond');
      conds.forEach((c) => cond.append(el('span', '', c)));
      const actions = el('div', 'i-actions');
      actions.append(
        btn('Salin kode', async () => {
          try { await navigator.clipboard.writeText(p.code); toast('Kode disalin.'); } catch { toast('Gagal menyalin.', true); }
        }),
        btn('Salin link', () => copy(`${SITE.url}/pesan?promo=${encodeURIComponent(p.code)}${p.services.length === 1 ? '&layanan=' + p.services[0] : ''}`)),
        btn('Edit', () => openPromo(p)),
        btn('Duplikat', () => {
          openPromo({ ...p, code: '', created_at: '' } as AdminPromo);
          editingPromo = null;
          $('[data-mdlg-title]').textContent = `Salin dari ${p.code}`;
          m.code.readOnly = false; m.code.focus();
          renderPromos();
        }),
        btn(p.is_active ? 'Nonaktifkan' : 'Aktifkan', async () => {
          try {
            await promoApi.update(p.code, { is_active: !p.is_active });
            p.is_active = !p.is_active; renderPromos();
            toast(p.is_active ? 'Promo diaktifkan.' : 'Promo dinonaktifkan.');
          } catch (e) { handle(e); }
        }),
        btn(openUses.has(p.code) ? 'Tutup pemakaian' : 'Pemakaian', () => {
          openUses.has(p.code) ? openUses.delete(p.code) : openUses.add(p.code); renderPromos();
        }),
        btn('Hapus', async () => {
          if (!confirm(`Hapus promo ${p.code} beserta riwayat pemakaiannya?`)) return;
          try {
            await promoApi.remove(p.code);
            promoList = promoList.filter((x) => x.code !== p.code);
            promoUses = promoUses.filter((u) => u.code !== p.code);
            renderPromos(); renderStats(); toast('Promo dihapus.');
          } catch (e) { handle(e); }
        }, 'danger'),
      );
      it.append(head, cond, meta, actions);
      if (openUses.has(p.code)) {
        const list = el('div', 'uses');
        const mine = promoUses.filter((u) => u.code === p.code);
        if (!mine.length) list.append(el('span', 'muted', 'Belum ada yang memakai kode ini.'));
        for (const u of mine) {
          const row = el('div', `u${u.status === 'cancelled' ? ' cancel' : ''}`);
          const who = [u.name || 'Tanpa nama', u.service ? svcShort(u.service) : 'Tanpa layanan', u.class_mode, u.phone ? `+${u.phone}` : '', fmtDT(u.created_at)];
          row.append(el('span', '', who.filter(Boolean).join(' · ')));
          row.append(btn(u.status === 'used' ? 'Batalkan' : 'Pulihkan', async () => {
            const next = u.status === 'used' ? 'cancelled' : 'used';
            try { await promoApi.setUse(u.id, next); u.status = next; renderPromos(); toast(next === 'cancelled' ? 'Pemakaian dibatalkan, kuota kembali.' : 'Pemakaian dipulihkan.'); }
            catch (e) { handle(e); }
          }));
          list.append(row);
        }
        it.append(list);
      }
      box.append(it);
    }
  }

  const mf = $<HTMLFormElement>('#promo-form');
  const m = {
    code: $<HTMLInputElement>('#m-code'), title: $<HTMLInputElement>('#m-title'), value: $<HTMLInputElement>('#m-value'),
    max: $<HTMLInputElement>('#m-max'), start: $<HTMLInputElement>('#m-start'), end: $<HTMLInputElement>('#m-end'),
    personal: $<HTMLInputElement>('#m-personal'), personalFor: $<HTMLInputElement>('#m-personal-for'),
    quota: $<HTMLInputElement>('#m-quota'), ppl: $<HTMLInputElement>('#m-ppl'), note: $<HTMLInputElement>('#m-note'),
    active: $<HTMLInputElement>('#m-active'), hours: $<HTMLInputElement>('#m-hours'),
    tstart: $<HTMLInputElement>('#m-tstart'), tend: $<HTMLInputElement>('#m-tend'),
  };
  const merr = $<HTMLElement>('[data-mform-err]');
  let editingPromo: AdminPromo | null = null;
  const mType = () => (mf.querySelector<HTMLInputElement>('input[name="m-type"]:checked')!.value as AdminPromo['discount_type']);
  const mMode = () => (mf.querySelector<HTMLInputElement>('input[name="m-mode"]:checked')?.value || null) as AdminPromo['class_mode'];
  const mDays = () => [...mf.querySelectorAll<HTMLInputElement>('input[name="m-day"]:checked')].map((x) => Number(x.value));
  const mSvcs = () => [...mf.querySelectorAll<HTMLInputElement>('input[name="m-svc"]:checked')].map((x) => x.value);
  const toLocal = (iso: string | null) => {
    if (!iso) return '';
    const d = new Date(iso);
    return new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
  };
  const fromLocal = (v: string) => (v ? new Date(v).toISOString() : null);
  const localStr = (d: Date) => toLocal(d.toISOString());

  function syncPromoForm() {
    const t = mType();
    $('[data-value-label]').textContent = t === 'percent' ? 'Diskon (%)' : t === 'amount' ? 'Potongan (Rp)' : 'Harga spesial (Rp)';
    m.value.max = t === 'percent' ? '100' : '';
    m.value.placeholder = t === 'percent' ? '20' : t === 'amount' ? '15000' : '80000';
    $<HTMLElement>('[data-max-wrap]').hidden = t !== 'percent';
    $<HTMLElement>('[data-personal-wrap]').hidden = !m.personal.checked;
    $<HTMLElement>('[data-quota-wrap]').hidden = m.personal.checked;
    $<HTMLElement>('[data-ppl-wrap]').hidden = m.personal.checked;
    $<HTMLElement>('[data-hours-wrap]').hidden = !m.hours.checked;
    const svcs = mSvcs();
    $<HTMLElement>('[data-mode-wrap]').hidden = svcs.length > 0 && !svcs.includes('kelas');

    const prev = $<HTMLElement>('[data-m-preview]');
    const v = Number(m.value.value);
    if (!(v > 0)) { prev.innerHTML = ''; return; }
    const rule = { discount_type: t, value: v, max_discount: t === 'percent' && Number(m.max.value) > 0 ? Number(m.max.value) : null };
    const lines: string[] = [svcs.length ? `Layanan: ${svcs.map(svcShort).join(', ')}` : 'Semua layanan'];
    const st = m.start.value, en = m.end.value;
    if (st || en) lines.push(`${st ? fmtDT(fromLocal(st)!) : 'Mulai sekarang'} sampai ${en ? fmtDT(fromLocal(en)!) : 'tanpa batas'}`);
    const dl = daysLabel(mDays());
    if (dl) lines.push(`Hanya hari ${dl}`);
    if (m.hours.checked && m.tstart.value && m.tend.value) lines.push(`Jam ${timeLabel(m.tstart.value, m.tend.value)}`);
    if (m.personal.checked) lines.push(`Khusus 1 orang${m.personalFor.value.trim() ? ': ' + m.personalFor.value.trim() : ''}`);
    else {
      lines.push(m.quota.value ? `Kuota ${m.quota.value} pemakaian` : 'Kuota tanpa batas');
      if (m.ppl.value) lines.push(`Maks. ${m.ppl.value}x per nomor WA`);
    }
    const mode = mMode();
    if (mode && !$<HTMLElement>('[data-mode-wrap]').hidden) lines.push(`Kelas coding hanya ${mode.toLowerCase()}`);
    if (!m.active.checked) lines.push('Belum aktif');
    prev.innerHTML = '';
    prev.append(el('strong', '', `${m.code.value || 'KODE'} · ${promoLabel(rule)}`), el('span', '', lines.join(' · ')));
  }
  mf.addEventListener('input', syncPromoForm);
  mf.addEventListener('change', syncPromoForm);
  syncPromoForm();

  // isi cepat
  mf.querySelectorAll<HTMLButtonElement>('[data-end]').forEach((b) => b.addEventListener('click', () => {
    const k = b.dataset.end!;
    if (!k) m.end.value = '';
    else {
      const base = m.start.value ? new Date(m.start.value) : new Date();
      const d = k === 'month' ? new Date(base.getFullYear(), base.getMonth() + 1, 0, 23, 59) : new Date(base.getTime() + Number(k) * 864e5);
      if (k !== 'month') d.setHours(23, 59, 0, 0);
      m.end.value = localStr(d);
    }
    syncPromoForm();
  }));
  mf.querySelectorAll<HTMLButtonElement>('[data-days]').forEach((b) => b.addEventListener('click', () => {
    const on = new Set(b.dataset.days!.split(',').filter(Boolean));
    mf.querySelectorAll<HTMLInputElement>('input[name="m-day"]').forEach((c) => (c.checked = on.has(c.value)));
    syncPromoForm();
  }));
  mf.querySelectorAll<HTMLButtonElement>('[data-quota]').forEach((b) => b.addEventListener('click', () => {
    m.quota.value = b.dataset.quota!; syncPromoForm();
  }));

  const mdlg = $<HTMLDialogElement>('[data-mdlg]');
  mdlg.addEventListener('close', () => { editingPromo = null; renderPromos(); });

  function openPromo(p: AdminPromo | null) {
    editingPromo = p;
    merr.hidden = true;
    $('[data-mdlg-title]').textContent = p ? `Edit promo ${p.code}` : 'Buat promo';
    m.code.value = p?.code ?? '';
    m.code.readOnly = !!p;
    m.title.value = p?.title ?? '';
    mf.querySelector<HTMLInputElement>(`input[name="m-type"][value="${p?.discount_type ?? 'percent'}"]`)!.checked = true;
    m.value.value = p ? String(p.value) : '';
    m.max.value = p?.max_discount ? String(p.max_discount) : '';
    mf.querySelectorAll<HTMLInputElement>('input[name="m-svc"]').forEach((c) => (c.checked = !!p?.services.includes(c.value)));
    mf.querySelector<HTMLInputElement>(`input[name="m-mode"][value="${p?.class_mode ?? ''}"]`)!.checked = true;
    m.start.value = toLocal(p?.starts_at ?? null);
    m.end.value = toLocal(p?.ends_at ?? null);
    const days = new Set((p?.days ?? []).map(String));
    mf.querySelectorAll<HTMLInputElement>('input[name="m-day"]').forEach((c) => (c.checked = days.has(c.value)));
    m.hours.checked = !!p?.time_start;
    m.tstart.value = p?.time_start?.slice(0, 5) ?? '19:00';
    m.tend.value = p?.time_end?.slice(0, 5) ?? '22:00';
    m.personal.checked = !!p?.personal_for;
    m.personalFor.value = p?.personal_for ?? '';
    m.quota.value = p?.quota && !p.personal_for ? String(p.quota) : '';
    m.ppl.value = p?.per_person_limit ? String(p.per_person_limit) : '';
    m.note.value = p?.note ?? '';
    m.active.checked = p?.is_active ?? true;
    syncPromoForm();
    if (!mdlg.open) mdlg.showModal();
    mf.scrollTop = 0; mdlg.scrollTop = 0;
    (p ? m.title : m.code).focus();
  }
  $('[data-add-promo]').addEventListener('click', () => openPromo(null));
  document.querySelectorAll('[data-mdlg-close]').forEach((b) => b.addEventListener('click', () => mdlg.close()));
  $('[data-rand-code]').addEventListener('click', () => {
    const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
    m.code.value = 'PAS' + Array.from(crypto.getRandomValues(new Uint8Array(5)), (b) => chars[b % chars.length]).join('');
    syncPromoForm();
  });
  m.code.addEventListener('input', () => { m.code.value = m.code.value.toUpperCase().replace(/[^A-Z0-9-]/g, ''); });

  mf.addEventListener('submit', async (e) => {
    e.preventDefault();
    merr.hidden = true;
    const t = mType();
    const code = m.code.value.trim();
    const value = Number(m.value.value);
    const max = Number(m.max.value) || null;
    const quota = m.personal.checked ? 1 : Number(m.quota.value) || null;
    const ppl = m.personal.checked ? null : Number(m.ppl.value) || null;
    const starts = fromLocal(m.start.value), ends = fromLocal(m.end.value);
    let days = mDays();
    if (days.length === 7) days = [];
    const hours = m.hours.checked;
    const svcs = mSvcs();
    const mode = svcs.length && !svcs.includes('kelas') ? null : mMode();
    const problem =
      !/^[A-Z0-9-]{3,24}$/.test(code) ? 'Kode harus 3 sampai 24 karakter (huruf besar, angka, minus).' :
      !(value > 0) ? 'Isi nilai potongan.' :
      t === 'percent' && value > 100 ? 'Persen maksimal 100.' :
      starts && ends && Date.parse(ends) <= Date.parse(starts) ? 'Tanggal berakhir harus setelah tanggal mulai.' :
      hours && (!m.tstart.value || !m.tend.value) ? 'Isi jam mulai dan jam selesai.' :
      hours && m.tstart.value === m.tend.value ? 'Jam mulai dan jam selesai tidak boleh sama.' :
      m.personal.checked && !m.personalFor.value.trim() ? 'Isi untuk siapa kode personal ini.' :
      (Number(m.quota.value) < 0 || Number(m.ppl.value) < 0) ? 'Kuota tidak boleh negatif.' :
      quota && ppl && ppl > quota ? 'Batas per orang tidak boleh lebih besar dari kuota total.' :
      !editingPromo && promoList.some((x) => x.code === code) ? 'Kode ini sudah dipakai promo lain.' : '';
    if (problem) { merr.textContent = problem; merr.hidden = false; merr.scrollIntoView({ block: 'nearest' }); return; }
    const data = {
      code, title: m.title.value.trim() || null, discount_type: t, value: Math.round(value),
      max_discount: t === 'percent' ? max : null,
      services: svcs, class_mode: mode, days,
      time_start: hours ? m.tstart.value : null, time_end: hours ? m.tend.value : null,
      starts_at: starts, ends_at: ends, quota, per_person_limit: ppl,
      personal_for: m.personal.checked ? m.personalFor.value.trim() : null,
      note: m.note.value.trim() || null, is_active: m.active.checked,
    };
    const save = $<HTMLButtonElement>('[data-msave]');
    save.disabled = true; save.textContent = 'Menyimpan…';
    const wasEdit = !!editingPromo;
    try {
      if (editingPromo) await promoApi.update(editingPromo.code, data); else await promoApi.create(data);
      [promoList, promoUses] = await Promise.all([promoApi.list(), promoApi.uses()]);
      renderStats();
      mdlg.close();
      toast(wasEdit ? 'Promo diperbarui.' : `Promo ${code} dibuat.`);
    } catch (err) {
      if (err instanceof AuthError) { mdlg.close(); handle(err); return; }
      const msg = err instanceof Error ? err.message : '';
      merr.textContent = /duplicate|unique/i.test(msg) ? 'Kode ini sudah dipakai promo lain.' : msg || 'Gagal menyimpan.';
      merr.hidden = false;
    } finally { save.disabled = false; save.textContent = 'Simpan promo'; }
  });

  // ---------- pesanan (struk) ----------
  const OR_LABEL: Record<AdminOrder['status'], [string, string]> = {
    menunggu: ['Menunggu', 'wait'], dikerjakan: ['Dikerjakan', 'run'], selesai: ['Selesai', 'ok'], batal: ['Batal', 'off'],
  };
  const svcTitle = (id: string) => SERVICES.find((s) => s.id === id)?.title ?? id;
  const showPhone = (p: string) => ('0' + p.replace(/^62/, '')).replace(/^(\d{4})(\d{4})(\d+)$/, '$1-$2-$3');
  const fmtDT2 = (iso: string) => new Date(iso).toLocaleString('id-ID', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });

  function renderOrders() {
    const box = $<HTMLElement>('[data-orders]');
    box.innerHTML = '';
    const q = orQuery.trim().toLowerCase();
    const qDigits = q.replace(/\D/g, '').replace(/^0/, '');
    const list = orderList.filter((o) =>
      (!orFilter || o.status === orFilter) &&
      (!q || o.code.toLowerCase().includes(q) || o.name.toLowerCase().includes(q) || (qDigits.length >= 3 && o.phone.includes(qDigits))));
    $('[data-orders-empty]').toggleAttribute('hidden', list.length > 0);
    $('[data-orders-empty]').textContent = orderList.length ? 'Tidak ada pesanan yang cocok.' : 'Belum ada pesanan.';
    for (const o of list) {
      const [label, cls] = OR_LABEL[o.status];
      const it = el('article', `item${o.status === 'batal' ? ' is-hidden' : ''}`);
      const head = el('div', 'i-head');
      const left = el('div');
      left.append(el('div', 'o-code', o.code), el('div', '', `${o.name} · ${svcTitle(o.service)}`));
      head.append(left, el('span', `badge ${cls}`, label));
      const meta = el('div', 'i-meta');
      meta.append(el('span', '', fmtDT2(o.created_at)));
      const wa = el('a', '', showPhone(o.phone)) as HTMLAnchorElement;
      wa.href = `https://wa.me/${o.phone}?text=${encodeURIComponent(`Halo Kak ${o.name}, soal pesanan PAS dengan kode struk ${o.code}:`)}`;
      wa.target = '_blank'; wa.rel = 'noopener';
      meta.append(wa);
      if (o.est_price !== null) meta.append(el('span', '', `Perkiraan ${rupiah(o.est_price)}`));
      if (o.promo_code) meta.append(el('span', 'code-txt', `Promo ${o.promo_code}`));
      if (o.final_price !== null) meta.append(el('strong', '', `Final ${rupiah(o.final_price)}`));
      if (o.reviewed_at) meta.append(el('span', 'o-flag', 'Sudah diulas'));
      const extra = el('div', 'o-extra');
      const e = o.extra ?? {};
      const ex: string[] = [];
      if (e.course) ex.push(e.course);
      if (e.lang) ex.push(e.lang);
      if (e.mode) ex.push(e.mode);
      if (e.deadline) ex.push(`${o.service === 'kelas' ? 'Mulai' : 'Deadline'} ${new Date(e.deadline + 'T00:00:00').toLocaleDateString('id-ID', { day: 'numeric', month: 'short' })}`);
      if (e.budget) ex.push(`Budget ${e.budget}`);
      ex.forEach((x) => extra.append(el('span', '', x)));

      const edit = el('form', 'o-edit') as HTMLFormElement;
      const stLab = el('label', '', 'Status');
      const sel = el('select', 'select') as HTMLSelectElement;
      (Object.keys(OR_LABEL) as AdminOrder['status'][]).forEach((k) => {
        const op = el('option', '', OR_LABEL[k][0]) as HTMLOptionElement;
        op.value = k; op.selected = k === o.status; sel.append(op);
      });
      stLab.append(sel);
      const prLab = el('label', '', 'Harga final (Rp)');
      const price = el('input', 'input') as HTMLInputElement;
      price.type = 'number'; price.inputMode = 'numeric'; price.min = '0'; price.placeholder = 'Contoh: 150000';
      price.value = o.final_price !== null ? String(o.final_price) : '';
      prLab.append(price);
      const noteLab = el('label', 'note', 'Catatan (hanya untukmu)');
      const note = el('input', 'input') as HTMLInputElement;
      note.maxLength = 200; note.value = o.admin_note ?? '';
      noteLab.append(note);
      const save = el('button', 'btn btn--sm', 'Simpan') as HTMLButtonElement;
      save.type = 'submit';
      edit.append(stLab, prLab, save, noteLab);
      edit.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const fp = price.value.trim() === '' ? null : Math.round(Number(price.value));
        if (fp !== null && (!Number.isFinite(fp) || fp < 0)) { toast('Harga final tidak valid.', true); price.focus(); return; }
        const next = sel.value as AdminOrder['status'];
        if (next === 'selesai' && o.status !== 'selesai' && fp === null && !confirm('Tandai selesai tanpa harga final?')) return;
        save.disabled = true; save.textContent = 'Menyimpan…';
        try {
          const [row] = await orderApi.update(o.code, { status: next, final_price: fp, admin_note: note.value.trim() || null });
          if (row) Object.assign(o, row);
          renderOrders(); renderStats();
          toast(next === 'selesai' && o.reviewed_at === null ? 'Disimpan. Pembeli sekarang bisa menulis ulasan.' : 'Pesanan disimpan.');
        } catch (err) { handle(err); save.disabled = false; save.textContent = 'Simpan'; }
      });

      const actions = el('div', 'i-actions');
      actions.append(
        btn('Salin link struk', () => copy(`${SITE.url}/struk?kode=${encodeURIComponent(o.code)}`)),
        btn('Hapus', async () => {
          const typed = prompt(`Hapus pesanan ${o.code} permanen? Ketik kodenya untuk konfirmasi.`);
          if (typed === null) return;
          if (typed.trim().toUpperCase() !== o.code) { toast('Kode tidak cocok, pesanan tidak dihapus.', true); return; }
          try {
            await orderApi.remove(o.code);
            orderList = orderList.filter((x) => x.code !== o.code);
            renderOrders(); renderStats(); toast('Pesanan dihapus.');
          } catch (err) { handle(err); }
        }, 'danger'),
      );
      it.append(head, meta);
      if (ex.length) it.append(extra);
      it.append(el('p', 'i-txt', o.detail), edit, actions);
      box.append(it);
    }
  }
  document.querySelectorAll<HTMLButtonElement>('[data-or-filter] button').forEach((b) =>
    b.addEventListener('click', () => {
      orFilter = b.dataset.st ?? '';
      document.querySelectorAll('[data-or-filter] button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      renderOrders();
    }),
  );
  $<HTMLInputElement>('[data-or-search]').addEventListener('input', (e) => { orQuery = (e.target as HTMLInputElement).value; renderOrders(); });

  // ---------- saran ----------
  const easeTxt = ['Sulit', 'Agak sulit', 'Biasa', 'Mudah', 'Sangat mudah'];
  function renderFeedback() {
    const box = $<HTMLElement>('[data-feedback]');
    box.innerHTML = '';
    const list = fbFilter ? fbList.filter((f) => f.status === fbFilter) : fbList;
    $('[data-feedback-empty]').toggleAttribute('hidden', list.length > 0);
    for (const f of list) {
      const it = el('article', `item${f.status === 'selesai' ? ' is-hidden' : ''}`);
      const head = el('div', 'i-head');
      const left = el('div', 'i-meta');
      left.append(el('span', 'tag', f.category));
      if (f.ease) left.append(el('span', '', `Kemudahan ${f.ease}/5 (${easeTxt[f.ease - 1]})`));
      left.append(el('span', '', fmtDate(f.created_at)));
      if (f.page) left.append(el('span', '', `dari ${f.page}`));
      head.append(left, el('span', `badge ${f.status === 'baru' ? 'wait' : f.status === 'dibaca' ? 'ok' : 'off'}`, f.status === 'baru' ? 'Baru' : f.status === 'dibaca' ? 'Dibaca' : 'Selesai'));
      const who = el('div', 'i-meta');
      who.append(el('strong', '', f.name || 'Anonim'));
      if (f.contact) who.append(el('span', '', f.contact));
      const actions = el('div', 'i-actions');
      const set = (st: Feedback['status'], label: string) =>
        btn(label, async () => {
          try { await fbApi.setStatus(f.id, st); f.status = st; renderFeedback(); renderStats(); } catch (e) { handle(e); }
        });
      if (f.status !== 'dibaca') actions.append(set('dibaca', 'Tandai dibaca'));
      if (f.status !== 'selesai') actions.append(set('selesai', 'Selesai ditindaklanjuti'));
      if (f.status !== 'baru') actions.append(set('baru', 'Tandai baru'));
      actions.append(btn('Hapus', async () => {
        if (!confirm('Hapus saran ini?')) return;
        try { await fbApi.remove(f.id); fbList = fbList.filter((x) => x.id !== f.id); renderFeedback(); renderStats(); toast('Saran dihapus.'); }
        catch (e) { handle(e); }
      }, 'danger'));
      it.append(head, el('p', 'i-txt', f.message), who, actions);
      box.append(it);
    }
  }
  document.querySelectorAll<HTMLButtonElement>('[data-fb-filter] button').forEach((b) =>
    b.addEventListener('click', () => {
      fbFilter = b.dataset.st || '';
      document.querySelectorAll('[data-fb-filter] button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      renderFeedback();
    }),
  );

  async function loadData() {
    [codes, reviews, projs, promoList, promoUses, fbList, orderList] = await Promise.all([
      api.listCodes(), api.listReviews(), projApi.list(), promoApi.list(), promoApi.uses(), fbApi.list(), orderApi.list(),
    ]);
    renderStats(); renderOrders(); renderReviews(); renderCodes(); renderProjects(); renderPromos(); renderFeedback();
  }

  async function enter() {
    const s = getSession();
    if (!s) { show('login'); return; }
    show('loading');
    try {
      const ok = await api.isAdmin();
      if (!ok) { $('[data-denied-email]').textContent = s.email; show('denied'); return; }
      $('[data-email]').textContent = getSession()?.email || s.email;
      await loadData();
      show('dash');
    } catch (e) { handle(e); }
  }

  // ---------- tampilkan / sembunyikan password ----------
  const eye = $<HTMLButtonElement>('[data-eye]');
  const passInput = $<HTMLInputElement>('#l-pass');
  const setEye = (show: boolean) => {
    passInput.type = show ? 'text' : 'password';
    eye.setAttribute('aria-pressed', String(show));
    eye.setAttribute('aria-label', show ? 'Sembunyikan password' : 'Tampilkan password');
  };
  eye.addEventListener('click', () => {
    const pos = passInput.selectionStart;
    setEye(passInput.type === 'password');
    passInput.focus();
    if (pos !== null) passInput.setSelectionRange(pos, pos);
  });

  // ---------- events ----------
  $<HTMLFormElement>('#login-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = $<HTMLInputElement>('#l-email').value.trim();
    const pass = $<HTMLInputElement>('#l-pass').value;
    const status = $('[data-login-status]');
    const b = $<HTMLButtonElement>('[data-login-btn]');
    if (!email || !pass) { status.textContent = 'Isi email dan password.'; return; }
    status.textContent = '';
    b.disabled = true; b.textContent = 'Memeriksa…';
    try {
      await login(email, pass);
      $<HTMLInputElement>('#l-pass').value = '';
      setEye(false);
      await enter();
    } catch (err) {
      status.textContent = err instanceof Error ? err.message : 'Gagal masuk.';
    } finally {
      b.disabled = false; b.textContent = 'Masuk';
    }
  });

  document.querySelectorAll('[data-logout]').forEach((b) =>
    b.addEventListener('click', async () => { await logout(); show('login'); }),
  );
  $('[data-refresh]').addEventListener('click', async () => {
    try { await loadData(); toast('Data diperbarui.'); } catch (e) { handle(e); }
  });

  $<HTMLFormElement>('#new-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const b = $<HTMLButtonElement>('[data-new-btn]');
    b.disabled = true; b.textContent = 'Membuat…';
    try {
      const client = $<HTMLInputElement>('#n-client').value;
      const code = await api.newCode(client, $<HTMLSelectElement>('#n-service').value, $<HTMLInputElement>('#n-note').value);
      $<HTMLInputElement>('[data-result-link]').value = reviewLink(code);
      $<HTMLAnchorElement>('[data-wa-result]').href = waShare(code, client.trim() || null);
      $('[data-result]').toggleAttribute('hidden', false);
      $<HTMLInputElement>('#n-client').value = '';
      $<HTMLInputElement>('#n-note').value = '';
      codes = await api.listCodes();
      renderCodes(); renderStats();
      toast(`Kode ${code} dibuat.`);
    } catch (err) { handle(err); }
    finally { b.disabled = false; b.textContent = 'Buat kode'; }
  });
  $('[data-copy-result]').addEventListener('click', () => copy($<HTMLInputElement>('[data-result-link]').value));

  // tabs (dengan navigasi panah kiri/kanan)
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
  const select = (t: HTMLButtonElement) => {
    tabs.forEach((x) => {
      const on = x === t;
      x.setAttribute('aria-selected', String(on));
      x.tabIndex = on ? 0 : -1;
      $(`[data-panel="${x.dataset.tab}"]`).toggleAttribute('hidden', !on);
    });
    t.focus();
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        select(tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length]);
      }
    });
  });

  enter();
</script>
