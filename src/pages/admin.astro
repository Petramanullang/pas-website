---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SERVICES } from '../config';
---

<Base title="Admin" noindex minimalHeader hideFooter>
  <section class="admin">
    <!-- LOGIN -->
    <div class="login-wrap" data-view="login" hidden>
      <form class="card login" id="login-form" novalidate>
        <img src="/logo.svg" alt="" width="84" height="51" />
        <h1>Admin PAS</h1>
        <p class="muted">Masuk dengan akun admin portofoliomu.</p>
        <div class="field">
          <label for="l-email">Email</label>
          <input class="input" id="l-email" type="email" autocomplete="username" required />
        </div>
        <div class="field">
          <label for="l-pass">Password</label>
          <div class="pass-wrap">
            <input class="input" id="l-pass" type="password" autocomplete="current-password" required />
            <button class="eye" type="button" data-eye aria-label="Tampilkan password" aria-pressed="false" aria-controls="l-pass">
              <span class="eye-show"><Icon name="eye" size={20} /></span>
              <span class="eye-hide"><Icon name="eyeoff" size={20} /></span>
            </button>
          </div>
        </div>
        <button class="btn btn--block" type="submit" data-login-btn>Masuk</button>
        <p class="status" role="alert" data-login-status></p>
      </form>
    </div>

    <!-- LOADING / NOT ADMIN -->
    <div class="center" data-view="loading">
      <p class="muted">Memuat…</p>
    </div>
    <div class="center" data-view="denied" hidden>
      <div class="card login">
        <h1>Bukan akun admin</h1>
        <p class="muted">Akun <strong data-denied-email></strong> tidak terdaftar sebagai admin.</p>
        <button class="btn btn--ghost" type="button" data-logout>Keluar</button>
      </div>
    </div>

    <!-- DASHBOARD -->
    <div class="dash" data-view="dash" hidden>
      <div class="top">
        <div>
          <h1>Dashboard PAS</h1>
          <p class="muted">Masuk sebagai <strong data-email></strong></p>
        </div>
        <div class="top-actions">
          <button class="btn btn--ghost sm" type="button" data-refresh><Icon name="refresh" size={18} /> Muat ulang</button>
          <button class="btn btn--ghost sm" type="button" data-logout>Keluar</button>
        </div>
      </div>

      <div class="stats">
        <div class="stat card"><span>Rata-rata rating</span><strong data-s-avg>0</strong></div>
        <div class="stat card"><span>Ulasan tampil</span><strong data-s-visible>0</strong></div>
        <div class="stat card"><span>Ulasan menunggu dicek</span><strong data-s-hidden>0</strong></div>
        <div class="stat card"><span>Pesanan berjalan</span><strong data-s-open>0</strong></div>
      </div>

      <div class="grid">
        <form class="card new" id="new-form">
          <h2>Buat kode ulasan</h2>
          <p class="muted small">Buat setelah pesanan selesai, lalu kirim link-nya ke klien.</p>
          <div class="field">
            <label for="n-client">Nama klien <span class="opt">(opsional, terisi otomatis di form)</span></label>
            <input class="input" id="n-client" maxlength="60" placeholder="Contoh: Budi" />
          </div>
          <div class="field">
            <label for="n-service">Layanan</label>
            <select class="select" id="n-service">
              {SERVICES.map((s) => <option value={s.title}>{s.title}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="n-note">Catatan <span class="opt">(hanya untukmu)</span></label>
            <input class="input" id="n-note" maxlength="120" placeholder="Contoh: website portofolio, selesai 15 Nov" />
          </div>
          <button class="btn btn--block" type="submit" data-new-btn>Buat kode</button>

          <div class="result" data-result hidden>
            <span class="res-label">Link ulasan</span>
            <div class="link-row">
              <input class="input mono" readonly data-result-link aria-label="Link ulasan" />
              <button class="btn btn--brand sm" type="button" data-copy-result>Salin</button>
            </div>
            <a class="btn btn--wa btn--block sm" data-wa-result target="_blank" rel="noopener"><Icon name="wa" /> Kirim lewat WhatsApp</a>
          </div>
        </form>

        <div class="card panel">
          <div class="tabs" role="tablist" aria-label="Data">
            <button role="tab" id="tab-orders" aria-controls="panel-orders" aria-selected="true" type="button" data-tab="orders">Pesanan <span data-c-orders>0</span></button>
            <button role="tab" id="tab-reviews" aria-controls="panel-reviews" aria-selected="false" type="button" data-tab="reviews" tabindex="-1">Ulasan <span data-c-reviews>0</span></button>
            <button role="tab" id="tab-codes" aria-controls="panel-codes" aria-selected="false" type="button" data-tab="codes" tabindex="-1">Kode <span data-c-codes>0</span></button>
            <button role="tab" id="tab-projects" aria-controls="panel-projects" aria-selected="false" type="button" data-tab="projects" tabindex="-1">Karya <span data-c-projects>0</span></button>
            <button role="tab" id="tab-promos" aria-controls="panel-promos" aria-selected="false" type="button" data-tab="promos" tabindex="-1">Promo <span data-c-promos>0</span></button>
            <button role="tab" id="tab-feedback" aria-controls="panel-feedback" aria-selected="false" type="button" data-tab="feedback" tabindex="-1">Saran <span data-c-feedback>0</span></button>
          </div>

          <div role="tabpanel" id="panel-orders" aria-labelledby="tab-orders" class="tabpanel" data-panel="orders">
            <div class="proj-bar">
              <div class="fb-filter" role="group" aria-label="Filter status pesanan" data-or-filter>
                <button type="button" data-st="" aria-pressed="true">Semua</button>
                <button type="button" data-st="menunggu" aria-pressed="false">Menunggu</button>
                <button type="button" data-st="dikerjakan" aria-pressed="false">Dikerjakan</button>
                <button type="button" data-st="selesai" aria-pressed="false">Selesai</button>
                <button type="button" data-st="batal" aria-pressed="false">Batal</button>
              </div>
              <input class="input or-search" type="search" placeholder="Cari kode, nama, nomor…" aria-label="Cari pesanan" data-or-search />
            </div>
            <p class="muted small or-help">Pesanan masuk dari form <a href="/pesan" target="_blank">/pesan</a>. Ubah status jadi <b>Selesai</b> supaya pembeli bisa menulis ulasan dari struknya.</p>
            <div class="list" data-orders></div>
            <p class="empty muted" data-orders-empty hidden>Belum ada pesanan.</p>
          </div>
          <div role="tabpanel" id="panel-reviews" aria-labelledby="tab-reviews" class="tabpanel" data-panel="reviews" hidden>
            <div class="list" data-reviews></div>
            <p class="empty muted" data-reviews-empty hidden>Belum ada ulasan.</p>
          </div>
          <div role="tabpanel" id="panel-codes" aria-labelledby="tab-codes" class="tabpanel" data-panel="codes" hidden>
            <div class="list" data-codes></div>
            <p class="empty muted" data-codes-empty hidden>Belum ada kode.</p>
          </div>
          <div role="tabpanel" id="panel-projects" aria-labelledby="tab-projects" class="tabpanel" data-panel="projects" hidden>
            <div class="proj-bar">
              <p class="muted small">Karya tampil di halaman <a href="/karya" target="_blank">/karya</a> sebagai map di laci arsip.</p>
              <button class="btn btn--sm" type="button" data-add-project><Icon name="plus" size={18} /> Tambah karya</button>
            </div>
            <div class="list" data-projects></div>
            <p class="empty muted" data-projects-empty hidden>Belum ada karya. Tambahkan yang pertama.</p>
          </div>
          <div role="tabpanel" id="panel-promos" aria-labelledby="tab-promos" class="tabpanel" data-panel="promos" hidden>
            <div class="proj-bar">
              <p class="muted small">Pelanggan memasukkan kode di halaman <a href="/pesan" target="_blank">/pesan</a>. Link langsung: <code>/pesan?promo=KODE</code></p>
              <button class="btn btn--sm" type="button" data-add-promo><Icon name="plus" size={18} /> Buat promo</button>
            </div>
            <div class="list" data-promos></div>
            <p class="empty muted" data-promos-empty hidden>Belum ada promo. Buat yang pertama.</p>
          </div>
          <div role="tabpanel" id="panel-feedback" aria-labelledby="tab-feedback" class="tabpanel" data-panel="feedback" hidden>
            <div class="proj-bar">
              <p class="muted small">Saran dari halaman <a href="/saran" target="_blank">/saran</a>. Hanya bisa dibaca admin.</p>
              <div class="fb-filter" role="group" aria-label="Filter status" data-fb-filter>
                <button type="button" data-st="" aria-pressed="true">Semua</button>
                <button type="button" data-st="baru" aria-pressed="false">Baru</button>
                <button type="button" data-st="dibaca" aria-pressed="false">Dibaca</button>
                <button type="button" data-st="selesai" aria-pressed="false">Selesai</button>
              </div>
            </div>
            <div class="list" data-feedback></div>
            <p class="empty muted" data-feedback-empty hidden>Belum ada saran.</p>
          </div>
        </div>
      </div>
    </div>

    <dialog class="pdlg" data-pdlg aria-labelledby="pdlg-title">
      <form class="pform" id="project-form" method="dialog" novalidate>
        <div class="pform-head">
          <h2 id="pdlg-title" data-pdlg-title>Tambah karya</h2>
          <button class="round round--light" type="button" data-pdlg-close aria-label="Tutup"><Icon name="close" size={20} /></button>
        </div>
        <div class="field">
          <label for="p-title">Judul <span class="req">*</span></label>
          <input class="input" id="p-title" maxlength="80" required placeholder="Contoh: Website Portofolio Armando" />
        </div>
        <div class="row2">
          <div class="field">
            <label for="p-cat">Kategori</label>
            <select class="select" id="p-cat"><option>Website</option><option>UI/UX</option><option>Lainnya</option></select>
          </div>
          <div class="field">
            <label for="p-year">Tahun</label>
            <input class="input" id="p-year" type="number" inputmode="numeric" min="2015" max="2100" placeholder="2026" />
          </div>
        </div>
        <div class="row2">
          <div class="field">
            <label for="p-client">Klien <span class="opt">(opsional)</span></label>
            <input class="input" id="p-client" maxlength="80" />
          </div>
          <div class="field">
            <label for="p-order">Urutan <span class="opt">(kecil = atas)</span></label>
            <input class="input" id="p-order" type="number" inputmode="numeric" value="0" />
          </div>
        </div>
        <div class="field">
          <label for="p-summary">Ringkasan</label>
          <textarea class="textarea" id="p-summary" maxlength="600" placeholder="Apa yang dikerjakan, untuk siapa, hasilnya seperti apa."></textarea>
        </div>
        <div class="field">
          <label for="p-tech">Teknologi <span class="opt">(pisahkan dengan koma)</span></label>
          <input class="input" id="p-tech" placeholder="React, Tailwind, Figma" />
        </div>
        <div class="field">
          <label for="p-url">Link <span class="opt">(opsional)</span></label>
          <input class="input" id="p-url" type="url" inputmode="url" placeholder="https://…" />
        </div>
        <div class="field">
          <span class="label">Gambar <span class="opt">(JPG/PNG/WebP, otomatis dikompres)</span></span>
          <div class="img-row">
            <div class="thumb" data-thumb><Icon name="image" size={26} /></div>
            <div class="img-actions">
              <label class="btn btn--sm btn--light file-btn">Pilih gambar<input type="file" accept="image/jpeg,image/png,image/webp" data-file hidden /></label>
              <button class="btn btn--sm btn--light" type="button" data-img-remove hidden>Hapus gambar</button>
            </div>
          </div>
        </div>
        <label class="check"><input type="checkbox" id="p-pub" checked /> Tampilkan di website</label>
        <p class="error" data-pform-err hidden></p>
        <div class="pform-foot">
          <button class="btn btn--light" type="button" data-pdlg-close>Batal</button>
          <button class="btn" type="submit" data-psave>Simpan</button>
        </div>
      </form>
    </dialog>

    <dialog class="pdlg mdlg" data-mdlg aria-labelledby="mform-title">
      <form class="pform mform" id="promo-form" novalidate>
        <div class="pform-head">
          <div>
            <h2 id="mform-title" data-mdlg-title>Buat promo</h2>
            <p class="muted small sub">Semua syarat opsional. Yang dikosongkan berarti tanpa batas.</p>
          </div>
          <button class="round round--light" type="button" data-mdlg-close aria-label="Tutup"><Icon name="close" size={20} /></button>
        </div>
        <div class="mcols">
          <div class="mcol">
              <section class="msec" aria-labelledby="ms-1">
                <h3 id="ms-1">Kode &amp; potongan</h3>
                <div class="field">
                  <label for="m-code">Kode promo <span class="req">*</span></label>
                  <div class="link-row">
                    <input class="input mono-up" id="m-code" maxlength="24" placeholder="HEMAT20" autocomplete="off" />
                    <button class="btn btn--sm btn--light" type="button" data-rand-code>Acak</button>
                  </div>
                  <span class="hint">Huruf besar, angka, minus. 3 sampai 24 karakter.</span>
                </div>
                <div class="field">
                  <label for="m-title">Judul promo <span class="opt">(tampil ke pelanggan)</span></label>
                  <input class="input" id="m-title" maxlength="80" placeholder="Contoh: Promo akhir semester" />
                </div>
                <fieldset class="field fs">
                  <legend class="label">Jenis potongan</legend>
                  <div class="seg3">
                    <label><input type="radio" name="m-type" value="percent" checked /> <span>Persen</span></label>
                    <label><input type="radio" name="m-type" value="amount" /> <span>Nominal</span></label>
                    <label><input type="radio" name="m-type" value="fixed_price" /> <span>Harga spesial</span></label>
                  </div>
                </fieldset>
                <div class="row2">
                  <div class="field">
                    <label for="m-value" data-value-label>Diskon (%)</label>
                    <input class="input" id="m-value" type="number" inputmode="numeric" min="1" />
                  </div>
                  <div class="field" data-max-wrap>
                    <label for="m-max">Maks. potongan <span class="opt">(Rp)</span></label>
                    <input class="input" id="m-max" type="number" inputmode="numeric" min="1" placeholder="25000" />
                  </div>
                </div>
              </section>
              <section class="msec" aria-labelledby="ms-5">
                <h3 id="ms-5">Lainnya</h3>
                <div class="field">
                  <label for="m-note">Catatan <span class="opt">(hanya untukmu)</span></label>
                  <input class="input" id="m-note" maxlength="200" />
                </div>
                <label class="check"><input type="checkbox" id="m-active" checked /> Aktif</label>
              </section>
          </div>
          <div class="mcol">
              <section class="msec" aria-labelledby="ms-2">
                <h3 id="ms-2">Kapan berlaku</h3>
                <div class="field">
                  <label for="m-start">Mulai</label>
                  <input class="input" id="m-start" type="datetime-local" />
                </div>
                <div class="field">
                  <label for="m-end">Berakhir</label>
                  <input class="input" id="m-end" type="datetime-local" />
                  <div class="quick" role="group" aria-label="Isi cepat tanggal berakhir">
                    <button type="button" data-end="7">7 hari</button>
                    <button type="button" data-end="14">14 hari</button>
                    <button type="button" data-end="30">30 hari</button>
                    <button type="button" data-end="month">Akhir bulan</button>
                    <button type="button" data-end="">Tanpa batas</button>
                  </div>
                </div>
                <fieldset class="field fs">
                  <legend class="label">Hari berlaku <span class="opt">(tidak dipilih = setiap hari)</span></legend>
                  <div class="days">
                    {['Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab', 'Min'].map((d, i) => (
                      <label><input type="checkbox" name="m-day" value={i + 1} /> <span>{d}</span></label>
                    ))}
                  </div>
                  <div class="quick" role="group" aria-label="Pilih hari cepat">
                    <button type="button" data-days="1,2,3,4,5">Hari kerja</button>
                    <button type="button" data-days="6,7">Akhir pekan</button>
                    <button type="button" data-days="">Setiap hari</button>
                  </div>
                </fieldset>
                <label class="check"><input type="checkbox" id="m-hours" /> Hanya jam tertentu</label>
                <div class="row2" data-hours-wrap hidden>
                  <div class="field">
                    <label for="m-tstart">Dari jam</label>
                    <input class="input" id="m-tstart" type="time" value="19:00" />
                  </div>
                  <div class="field">
                    <label for="m-tend">Sampai jam</label>
                    <input class="input" id="m-tend" type="time" value="22:00" />
                  </div>
                  <span class="hint span2">WIB. Boleh lewat tengah malam (22.00 sampai 02.00).</span>
                </div>
              </section>
          </div>
          <div class="mcol">
              <section class="msec" aria-labelledby="ms-3">
                <h3 id="ms-3">Batas pemakaian</h3>
                <label class="check"><input type="checkbox" id="m-personal" /> Khusus 1 orang (sekali pakai)</label>
                <div class="field" data-personal-wrap hidden>
                  <label for="m-personal-for">Untuk siapa?</label>
                  <input class="input" id="m-personal-for" maxlength="80" placeholder="Contoh: Budi (klien lama)" />
                </div>
                <div class="field" data-quota-wrap>
                  <label for="m-quota">Kuota total <span class="opt">(kosong = tanpa batas)</span></label>
                  <input class="input" id="m-quota" type="number" inputmode="numeric" min="1" placeholder="Contoh: 10" />
                  <div class="quick" role="group" aria-label="Isi cepat kuota">
                    <button type="button" data-quota="5">5</button>
                    <button type="button" data-quota="10">10</button>
                    <button type="button" data-quota="25">25</button>
                    <button type="button" data-quota="50">50</button>
                    <button type="button" data-quota="">Tanpa batas</button>
                  </div>
                </div>
                <div class="field" data-ppl-wrap>
                  <label for="m-ppl">Maks. per orang <span class="opt">(kosong = bebas)</span></label>
                  <input class="input" id="m-ppl" type="number" inputmode="numeric" min="1" placeholder="Contoh: 1" />
                  <span class="hint">Dicek dari nomor WhatsApp pembeli.</span>
                </div>
              </section>
              <section class="msec" aria-labelledby="ms-4">
                <h3 id="ms-4">Syarat pesanan</h3>
                <fieldset class="field fs">
                  <legend class="label">Layanan <span class="opt">(tidak dicentang = semua)</span></legend>
                  <div class="svc-checks">
                    {SERVICES.map((s) => <label class="check"><input type="checkbox" name="m-svc" value={s.id} /> {s.short}</label>)}
                  </div>
                </fieldset>
                <fieldset class="field fs" data-mode-wrap>
                  <legend class="label">Mode kelas coding</legend>
                  <div class="seg3">
                    <label><input type="radio" name="m-mode" value="" checked /> <span>Semua</span></label>
                    <label><input type="radio" name="m-mode" value="Online" /> <span>Online</span></label>
                    <label><input type="radio" name="m-mode" value="Offline" /> <span>Offline</span></label>
                  </div>
                </fieldset>
              </section>
          </div>
        </div>
        <div class="mfoot">
          <div class="preview" data-m-preview></div>
          <div class="mfoot-r">
            <p class="error" data-mform-err hidden></p>
            <div class="pform-foot">
              <button class="btn btn--light" type="button" data-mdlg-close>Batal</button>
              <button class="btn" type="submit" data-msave>Simpan promo</button>
            </div>
          </div>
        </div>
      </form>
    </dialog>

    <div class="toast" role="status" aria-live="polite" data-toast></div>
  </section>
</Base>

<style>
  .admin { min-height: calc(100vh - var(--header-h)); padding-block: 1rem 3rem; }
  [data-view][hidden] { display: none !important; }
  .muted { color: var(--muted); }
  .small { font-size: 0.9rem; }
  .opt { font-weight: 400; color: var(--muted); font-size: 0.85rem; }
  .center { display: grid; place-items: center; min-height: 50vh; }
  .login-wrap { display: grid; place-items: center; min-height: 65vh; }
  .login { width: min(100%, 420px); padding: 2rem; display: grid; gap: 1rem; box-shadow: var(--shadow); }
  .login img { width: 84px; height: auto; }
  .login h1 { font-size: 1.6rem; margin: 0; }
  .login p { margin: 0; }
  .status { margin: 0; min-height: 1.3em; color: var(--err); font-weight: 600; font-size: 0.92rem; }

  .top { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
  .top h1 { font-size: clamp(1.6rem, 3vw, 2.1rem); margin-bottom: 0.2rem; }
  .top p { margin: 0; }
  .top-actions { display: flex; gap: 0.5rem; }
  .sm { min-height: 40px; padding: 0.45rem 0.95rem; font-size: 0.9rem; }

  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 1.5rem; }
  .stat { padding: 1rem 1.2rem; display: grid; gap: 0.15rem; }
  .stat span { font-size: 0.85rem; color: var(--muted); }
  .stat strong { font-family: var(--font-head); font-size: 1.7rem; }

  .grid { display: grid; grid-template-columns: 360px 1fr; gap: 1.25rem; align-items: start; }
  .new { padding: 1.5rem; display: grid; gap: 1rem; position: sticky; top: calc(var(--header-h) + 1rem); }
  .new h2 { font-size: 1.2rem; margin: 0; }
  .new p { margin: -0.6rem 0 0; }
  .result { display: grid; gap: 0.55rem; padding: 1rem; border-radius: var(--radius); background: var(--bg-warm); border: 1px solid #f6e2ad; }
  .result[hidden] { display: none; }
  .res-label { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .link-row { display: grid; grid-template-columns: 1fr auto; gap: 0.5rem; }
  .mono { font-family: ui-monospace, 'SFMono-Regular', Consolas, monospace; font-size: 0.85rem; min-height: 40px; }

  .panel { padding: 0.5rem; min-width: 0; }
  .tabs { display: flex; gap: 0.25rem; padding: 0.25rem; border-bottom: 1px solid var(--line); overflow-x: auto; scrollbar-width: none; }
  .tabs button {
    border: 0; background: transparent; padding: 0.6rem 1rem; border-radius: 10px; font-weight: 650; cursor: pointer; color: var(--muted);
    display: inline-flex; gap: 0.45rem; align-items: center; min-height: 42px;
  }
  .tabs button span { font-size: 0.78rem; padding: 0.05rem 0.5rem; border-radius: 99px; background: var(--bg-soft); }
  .tabs button[aria-selected='true'] { background: var(--ink); color: #fff; }
  .tabs button[aria-selected='true'] span { background: rgb(255 255 255 / 0.18); }
  .tabpanel { padding: 0.75rem; }
