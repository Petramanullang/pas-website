  :global(.i-actions button), :global(.i-actions a) {
    border: 1px solid var(--line); background: #fff; border-radius: 999px; padding: 0.35rem 0.8rem; font-size: 0.85rem; font-weight: 600;
    cursor: pointer; min-height: 36px; text-decoration: none; display: inline-flex; align-items: center; gap: 0.35rem;
  }
