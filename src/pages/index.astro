---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Dial from '../components/Dial.astro';
import { SERVICES, STEPS, CONTACT, FAQ } from '../config';
---

<Base home>
  <div class="home">
    <!-- HERO -->
    <section class="panel panel--dark hero" aria-labelledby="hero-title">
      <div class="copy">
        <div class="visual" aria-hidden="true"><Dial /></div>
        <p class="kicker">Petra All Service</p>
        <h1 id="hero-title">Tugas, website, desain, sampai belajar coding. Semua jadi <span class="hl">pas.</span></h1>
        <p class="muted lead">Bantuan tugas kuliah, pembuatan website, desain UI/UX, dan kelas coding. Harga ramah mahasiswa, bisa diskusi dulu sebelum order.</p>
        <div class="ctas">
          <a class="btn btn--brand" href="/pesan">Pesan sekarang <Icon name="upright" size={18} /></a>
          <a class="btn btn--ghost" href="/layanan">Lihat layanan</a>
        </div>
      </div>
      <ul class="stats" aria-label="Ringkasan">
        <li><strong>Rp30rb</strong><span>harga mulai</span></li>
        <li><strong>{SERVICES.length}</strong><span>layanan</span></li>
        <li data-hero-rating hidden><strong data-hero-avg></strong><span data-hero-count></span></li>
      </ul>
    </section>

    <!-- PINTASAN -->
    <a class="tile t-layanan panel" href="/layanan">
      <span class="t-head"><span class="t-title">Layanan</span><span class="go"><Icon name="arrow" size={18} /></span></span>
      <span class="t-big">{SERVICES.length} layanan</span>
      <span class="t-sub">Tugas, website, UI/UX, kelas coding, dan lainnya. Mulai Rp30rb.</span>
    </a>

    <a class="tile t-testi panel" href="/testimoni">
      <span class="t-head"><span class="t-title">Testimoni</span><span class="go"><Icon name="arrow" size={18} /></span></span>
      <span class="t-big" data-testi-big>Ulasan</span>
      <span class="t-sub" data-testi-sub>Ulasan asli dari pelanggan PAS.</span>
    </a>

    <a class="tile t-karya panel panel--soft" href="/karya">
      <span class="t-head"><span class="t-title">Karya</span><span class="go"><Icon name="arrow" size={18} /></span></span>
      <span class="mini" aria-hidden="true" data-mini>
        {[0, 1, 2].map((i) => (
          <span class="mf" style={`--i:${i}`}><span class="mf-tab"><b>{String(i + 1).padStart(3, '0')}</b><em></em></span></span>
        ))}
        <span class="mf-front"><span class="label">arsip karya PAS</span></span>
      </span>
    </a>

    <a class="tile t-cara panel" href="/cara-pesan">
      <span class="t-head"><span class="t-title">Cara pesan</span><span class="go"><Icon name="arrow" size={18} /></span></span>
      <span class="nodes" aria-hidden="true">
        {STEPS.map((_, i) => <span class:list={['node', { last: i === STEPS.length - 1 }]}>{i + 1}</span>)}
      </span>
      <span class="t-sub">{STEPS.length} langkah, dari tanya sampai selesai.</span>
    </a>

    <div class="duo">
      <a class="tile mini-tile panel" href="/faq">
        <span class="t-head"><span class="t-title">FAQ</span><span class="go"><Icon name="arrow" size={16} /></span></span>
        <span class="t-sub">{FAQ.length} jawaban cepat</span>
      </a>
      <a class="tile mini-tile panel" href="/saran">
        <span class="t-head"><span class="t-title">Saran</span><span class="go"><Icon name="arrow" size={16} /></span></span>
        <span class="t-sub">Bantu PAS jadi lebih baik</span>
      </a>
    </div>

    <a class="tile t-pesan panel panel--brand" href="/pesan">
      <span class="t-head"><span class="t-title">Mulai pesan</span><span class="go dark"><Icon name="arrow" size={20} /></span></span>
      <span class="t-big">Isi form, lanjut WhatsApp.</span>
      <span class="t-sub">Atau chat langsung {CONTACT.phoneDisplay}</span>
    </a>
  </div>
</Base>

<style>
  .home {
    height: 100%; display: grid; gap: var(--gap);
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: repeat(4, minmax(0, 1fr));
  }
  /* HERO */
  .hero { grid-column: 1; grid-row: 1 / 5; display: grid; grid-template-rows: minmax(0, 1fr) auto; gap: 1rem; padding: clamp(1.5rem, 3vw, 2.8rem); min-height: 0; overflow: hidden; }
  .copy { align-self: center; min-width: 0; }
  .hero h1 { color: #fff; font-size: clamp(1.9rem, min(3.2vw, 6vh), 3.6rem); margin-bottom: 0.4em; }
  .hl { background: var(--brand); color: var(--ink); padding: 0 0.16em; border-radius: 0.16em; }
  .lead { font-size: clamp(0.95rem, 1.9vh, 1.08rem); max-width: 44ch; margin: 0; }
  .ctas { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: clamp(1rem, 3vh, 1.8rem); }
  .hero .btn--ghost { color: #fff; border-color: rgb(255 255 255 / 0.35); }
  .hero .btn--ghost:hover { border-color: #fff; }
  .visual { float: right; width: min(34%, 27vh); aspect-ratio: 1; shape-outside: circle(50%); shape-margin: 0.8rem; margin: 0 -0.5rem 0.5rem 1rem; }
  .visual :global(.dial) { width: 100%; }
  .stats {
    justify-self: start; list-style: none; margin: 0; padding: 0.45rem 0.55rem; display: flex; border-radius: 999px;
    background: rgb(255 255 255 / 0.08);
  }
  .stats li { display: grid; text-align: center; padding: 0.1rem 1rem; line-height: 1.2; }
  .stats li + li { border-left: 1px solid rgb(255 255 255 / 0.18); }
  .stats li[hidden] { display: none; }
  .stats strong { font-family: var(--font-head); font-size: 1.15rem; color: #fff; }
  .stats span { font-size: 0.74rem; color: #b9b6ad; }

  /* TILES */
  .tile { display: flex; flex-direction: column; gap: 0.35rem; text-decoration: none; min-height: 0; overflow: hidden; padding: clamp(1rem, 2.2vh, 1.6rem) clamp(1.1rem, 1.6vw, 1.6rem); transition: transform 0.25s cubic-bezier(.2,.8,.2,1), background-color 0.2s ease; }
  .tile:hover { transform: translateY(-3px); }
  .t-head { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; }
  .t-title { font-family: var(--font-head); font-weight: 750; font-size: clamp(1.05rem, 2.2vh, 1.3rem); }
  .go { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; background: var(--panel-2); flex: none; transition: background-color 0.2s ease, color 0.2s ease, transform 0.25s ease; }
  .tile:hover .go { background: var(--ink); color: #fff; transform: rotate(-45deg); }
  .go.dark { background: var(--ink); color: var(--brand); width: 42px; height: 42px; }
  .t-big { font-family: var(--font-head); font-weight: 800; font-size: clamp(1.4rem, 3.6vh, 2.2rem); line-height: 1.05; margin-top: auto; letter-spacing: -0.02em; }
  .t-sub { font-size: clamp(0.8rem, 1.6vh, 0.92rem); color: var(--muted); line-height: 1.35; }
  .panel--brand .t-sub { color: var(--ink-2); }

  .t-layanan { grid-column: 2; grid-row: 1; }
  .t-testi { grid-column: 3; grid-row: 1; }
  .t-karya { grid-column: 2 / 4; grid-row: 2; }
  .t-cara { grid-column: 2; grid-row: 3; }
  .duo { grid-column: 3; grid-row: 3; display: grid; grid-template-rows: 1fr 1fr; gap: var(--gap); min-height: 0; }
  .mini-tile { justify-content: space-between; border-radius: 24px; padding-block: clamp(0.7rem, 1.6vh, 1.1rem); }
  .t-pesan { grid-column: 2 / 4; grid-row: 4; }
  .t-pesan .t-big { font-size: clamp(1.3rem, 3.3vh, 2rem); }

  /* mini laci */
  .mini { display: grid; margin-top: auto; padding-top: 1.3rem; }
  .mf { --w: calc(80% + var(--i) * 8%); display: block; position: relative; width: var(--w); margin: -12px auto 0; height: clamp(22px, 3.2vh, 34px); border: 1.5px solid var(--ink); border-bottom: 0; border-radius: 10px 10px 0 0; background: var(--panel-2); transition: transform 0.25s ease; }
  .mf:first-child { margin-top: 0; }
  .mf-tab { position: absolute; top: -22px; height: 23px; min-width: 42%; max-width: 60%; display: flex; justify-content: space-between; gap: 0.8rem; padding: 0 0.75rem; align-items: center; border: 1.5px solid var(--ink); border-bottom: 0; border-radius: 9px 9px 0 0; background: var(--panel-2); font-size: 0.74rem; }
  .mf:nth-child(odd) .mf-tab { left: 6%; }
  .mf:nth-child(even) .mf-tab { right: 6%; }
  .mf-tab b { font-weight: 600; }
  .mf-tab em { font-style: normal; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tile:hover .mf:nth-child(2) { transform: translateY(-6px); }
  .mf-front { display: grid; place-items: center; margin-top: -8px; height: clamp(30px, 4.6vh, 48px); border: 1.5px solid var(--ink); border-radius: 0 0 14px 14px; background: #fff; position: relative; }
  .label { background: var(--brand); padding: 0.15rem 0.7rem; border-radius: 8px; border: 1.5px solid var(--ink); font-weight: 600; font-size: 0.75rem; }

  /* node cara pesan */
  .nodes { display: flex; align-items: center; justify-content: space-between; position: relative; margin-top: auto; padding: 0.3rem 0; }
  .nodes::before { content: ''; position: absolute; left: 14px; right: 14px; top: 50%; height: 2px; background: repeating-linear-gradient(90deg, var(--line) 0 6px, transparent 6px 11px); }
  .node { position: relative; width: clamp(26px, 4vh, 34px); height: clamp(26px, 4vh, 34px); border-radius: 50%; display: grid; place-items: center; background: var(--brand); font-weight: 800; font-family: var(--font-head); font-size: 0.9rem; box-shadow: 0 0 0 5px var(--panel); }
  .node.last { background: var(--ink); color: #fff; }

  /* Tablet */
  @media (max-width: 1100px) {
    .home { grid-template-columns: repeat(4, minmax(0, 1fr)); grid-template-rows: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 0.9fr); }
    .hero { grid-column: 1 / 5; grid-row: 1 / 3; }
    .t-layanan { grid-column: 1; grid-row: 3; }
    .t-karya { grid-column: 2; grid-row: 3; }
    .t-testi { grid-column: 3; grid-row: 3; }
    .t-cara { grid-column: 4; grid-row: 3; }
    .duo, .t-pesan { display: none; }
    .t-karya .mini { display: none; }
    .t-karya::after { content: 'Arsip proyek yang sudah jadi'; margin-top: auto; font-size: 0.85rem; color: var(--muted); }
  }
  /* HP */
  @media (max-width: 860px) {
    .home { grid-template-columns: 1fr 1fr; grid-template-rows: minmax(0, 1fr) auto auto; gap: 10px; }
    .hero { grid-column: 1 / 3; grid-row: 1; grid-template-columns: 1fr; grid-template-rows: 1fr auto; padding: 1.4rem 1.3rem 1.1rem; }
    .visual { display: none; }
    .hero h1 { font-size: clamp(1.7rem, min(8.4vw, 4.9vh), 2.6rem); }
    .hero .btn--ghost { display: none; }
    .lead { font-size: clamp(0.88rem, 2vh, 1rem); }
    .ctas .btn { flex: 1 1 auto; min-height: 44px; }
    .stats { justify-self: stretch; justify-content: space-around; }
    .stats li { padding-inline: 0.5rem; }
    .tile { padding: 0.85rem 1rem; border-radius: 24px; gap: 0.15rem; }
    .t-layanan { grid-column: 1; grid-row: 2; }
    .t-karya { grid-column: 2; grid-row: 2; }
    .t-testi { grid-column: 1; grid-row: 3; }
    .t-cara { grid-column: 2; grid-row: 3; }
    .t-big { font-size: clamp(1.05rem, 2.6vh, 1.35rem); margin-top: 0.3rem; }
    .t-sub { display: none; }
    .nodes { display: none; }
    .t-karya::after, .t-cara::after { margin-top: 0.3rem; font-family: var(--font-head); font-weight: 800; font-size: clamp(1.05rem, 2.6vh, 1.35rem); color: var(--ink); }
    .t-karya::after { content: 'Arsip proyek'; }
    .t-cara::after { content: '4 langkah'; }
    .go { width: 30px; height: 30px; }
  }
  @media (max-width: 860px) and (max-height: 820px) { .stats { display: none; } }
  @media (max-width: 860px) and (max-height: 760px) {
    .lead { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .hero { padding-block: 1.1rem 1rem; }
    .ctas { margin-top: 0.8rem; }
  }
  @media (max-width: 860px) and (max-height: 660px) { .lead { display: none; } }
  @media (min-width: 1101px) and (max-height: 820px) {
    .mini-tile .t-sub, .t-cara .t-sub { display: none; }
    .mf:nth-child(3) { display: none; }
  }
  @media (min-width: 1101px) and (max-height: 700px) {
    .t-sub { display: none; }
    .visual { display: none; }
  }
</style>

<script>
  import { getReviews, getProjects } from '../lib/supabase';

  getReviews(200)
    .then((list) => {
      const big = document.querySelector<HTMLElement>('[data-testi-big]')!;
      const sub = document.querySelector<HTMLElement>('[data-testi-sub]')!;
      if (!list.length) { big.textContent = 'Segera hadir'; sub.textContent = 'Ulasan pertama tampil di sini setelah pesanan selesai.'; return; }
      const avg = (list.reduce((a, r) => a + r.rating, 0) / list.length).toFixed(1).replace('.', ',');
      big.textContent = `★ ${avg}`;
      sub.textContent = `dari ${list.length} ulasan pelanggan`;
      const hero = document.querySelector<HTMLElement>('[data-hero-rating]');
      if (hero) {
        hero.hidden = false;
        hero.querySelector('[data-hero-avg]')!.textContent = `★ ${avg}`;
        hero.querySelector('[data-hero-count]')!.textContent = `${list.length} ulasan`;
      }
    })
    .catch(() => {});

  getProjects(3)
    .then((list) => {
      const tabs = document.querySelectorAll<HTMLElement>('[data-mini] .mf em');
      list.slice(0, tabs.length).forEach((p, i) => { tabs[i].textContent = p.title; });
    })
    .catch(() => {});
</script>
