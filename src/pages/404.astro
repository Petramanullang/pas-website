---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Halaman tidak ditemukan" noindex minimalHeader>
  <section class="panel nf">
    <p class="code">404</p>
    <h1>Halaman ini belum <span class="mark">pas</span>.</h1>
    <p class="muted">Sepertinya link-nya salah atau halaman sudah dipindahkan.</p>
    <a class="btn" href="/"><Icon name="home" size={18} /> Kembali ke beranda</a>
  </section>
</Base>

<style>
  .nf { min-height: 60vh; display: grid; place-content: center; justify-items: center; text-align: center; padding-block: 4rem; }
  .code { font-family: var(--font-head); font-weight: 800; font-size: 4.5rem; line-height: 1; margin: 0 0 1rem; color: var(--brand-deep); }
  .muted { color: var(--muted); margin-bottom: 1.75rem; }
</style>
