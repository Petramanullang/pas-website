---
// Piringan dekoratif ala "speaker" (referensi gambar 2): cincin teks layanan yang berputar pelan.
const ring = 'WEBSITE • DESAIN UI/UX • KELAS CODING • BANTUAN TUGAS • ';
const ticks = Array.from({ length: 72 }, (_, i) => i);
---

<div class="dial" aria-hidden="true">
  <svg viewBox="0 0 400 400" width="400" height="400">
    <defs>
      <radialGradient id="disc" cx="50%" cy="38%" r="70%">
        <stop offset="0" stop-color="#2d2c2a" />
        <stop offset="1" stop-color="#121212" />
      </radialGradient>
      <path id="ringPath" d="M200,200 m-150,0 a150,150 0 1,1 300,0 a150,150 0 1,1 -300,0" />
    </defs>
    <circle cx="200" cy="200" r="196" fill="none" stroke="#2a2927" stroke-width="2" />
    <circle cx="200" cy="200" r="176" fill="#1a1a19" />
    <g class="spin">
      <text font-size="15" font-weight="700" fill="#8d8a82" font-family="Inter Variable, sans-serif">
        <textPath href="#ringPath" textLength="938" lengthAdjust="spacing">{ring}</textPath>
      </text>
    </g>
    <g class="ticks">
      {ticks.map((i) => {
        const a = (i / ticks.length) * Math.PI * 2;
        const r1 = i % 6 === 0 ? 118 : 123;
        return (
          <line
            x1={200 + Math.cos(a) * r1} y1={200 + Math.sin(a) * r1}
            x2={200 + Math.cos(a) * 128} y2={200 + Math.sin(a) * 128}
            stroke={i % 6 === 0 ? '#ffc83d' : '#4a4844'} stroke-width={i % 6 === 0 ? 2.5 : 1.5} stroke-linecap="round"
          />
        );
      })}
    </g>
    <circle cx="200" cy="200" r="104" fill="url(#disc)" />
    <circle cx="200" cy="200" r="104" fill="none" stroke="#33322f" stroke-width="1.5" />
    <text x="200" y="217" text-anchor="middle" font-family="Urbanist Variable, sans-serif" font-weight="850" font-size="54" fill="#ffc83d" letter-spacing="-1">PAS</text>
    <g stroke="#6f6c65" stroke-width="2" stroke-linecap="round">
      <path d="M200 132v10M195 137h10" />
      <path d="M195 266h10" />
      <circle cx="146" cy="200" r="2.4" fill="#6f6c65" stroke="none" />
      <circle cx="254" cy="200" r="2.4" fill="#6f6c65" stroke="none" />
    </g>
    <circle class="pulse" cx="200" cy="246" r="4" fill="#ffc83d" />
  </svg>
</div>

<style>
  .dial { width: 100%; max-width: 400px; aspect-ratio: 1; }
  .dial svg { width: 100%; height: 100%; }
  .spin { transform-origin: 200px 200px; animation: spin 48s linear infinite; }
  .pulse { animation: pulse 2.4s ease-in-out infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes pulse { 50% { opacity: 0.25; } }
</style>
