---
import Icon from './Icon.astro';
---

<div class="tm" aria-busy="true" data-reviews>
  <section class="panel panel--dark summary" aria-label="Ringkasan rating">
    <p class="kicker">Rating pelanggan</p>
    <div class="avg">
      <strong data-avg hidden></strong>
      <div>
        <span class="stars big" data-avg-stars aria-hidden="true">
          {[1, 2, 3, 4, 5].map(() => <Icon name="star" size={22} class="off" />)}
        </span>
        <p class="count" data-count>Memuat ulasan…</p>
      </div>
    </div>
    <ul class="dist" data-dist>
      {[5, 4, 3, 2, 1].map((n) => (
        <li>
          <span class="n">{n}★</span>
          <span class="bar"><span style="width:0%" data-bar={n}></span></span>
          <span class="c" data-bar-count={n}>0</span>
        </li>
      ))}
    </ul>
    <div class="filters" role="group" aria-label="Filter layanan" data-filters hidden></div>
    <a class="btn btn--brand btn--block write" href="/ulasan"><Icon name="pen" size={18} /> Tulis ulasan</a>
    <p class="note">Hanya pembeli yang bisa menulis ulasan: lewat struk pesanan yang sudah selesai atau kode dari Petra. Setiap ulasan dicek sebelum tampil.</p>
  </section>

  <div class="list">
    <div class="grid" data-grid>
      {[1, 2, 3, 4].map(() => (
        <div class="sk" aria-hidden="true"><span></span><span></span><span></span><span class="short"></span></div>
      ))}
    </div>

    <div class="panel empty" data-empty hidden>
      <h2>Belum ada ulasan</h2>
      <p class="muted">Ulasan pertama akan tampil di sini setelah pesanan selesai.</p>
      <a class="btn" href="/pesan">Pesan sekarang</a>
    </div>

    <div class="panel empty" data-error hidden>
      <h2>Ulasan belum bisa dimuat</h2>
      <p class="muted">Periksa koneksi internetmu, lalu coba lagi.</p>
      <button class="btn btn--light" type="button" data-retry><Icon name="refresh" size={18} /> Coba lagi</button>
    </div>

    <button class="btn btn--light more" type="button" data-more hidden>Tampilkan lebih banyak</button>
  </div>
</div>

<template id="review-tpl">
  <article class="rv">
    <div class="rv-top">
      <span class="stars" data-stars></span>
      <span class="svc" data-svc></span>
    </div>
    <p class="txt" data-txt></p>
    <footer class="who">
      <span class="av" data-av aria-hidden="true"></span>
      <span class="meta"><strong data-name></strong><time data-date></time></span>
      <span class="vb" data-verified hidden title="Ulasan ini ditulis dari struk pesanan yang sudah selesai">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 5 6v5.5c0 4.3 3 8 7 9.5 4-1.5 7-5.2 7-9.5V6z"/><path d="m9 12 2 2 4-4"/></svg>
        Pembeli terverifikasi
      </span>
    </footer>
  </article>
</template>

<style>
  .tm { display: grid; grid-template-columns: 360px 1fr; gap: var(--gap); align-items: start; }
  .summary { position: sticky; top: calc(var(--nav-h) + 12px); display: grid; gap: 1rem; }
  .summary .kicker { margin: 0; }
  .avg { display: flex; align-items: center; gap: 1rem; }
  .avg > strong { font-family: var(--font-head); font-size: 4rem; line-height: 0.9; color: #fff; font-weight: 800; }
  .count { margin: 0.3rem 0 0; color: #b9b6ad; font-size: 0.9rem; }
  .stars.big :global(svg) { width: 22px; height: 22px; }
  .dist { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.45rem; }
  .dist li { display: grid; grid-template-columns: 2rem 1fr 1.6rem; align-items: center; gap: 0.6rem; font-size: 0.85rem; color: #b9b6ad; }
  .bar { height: 8px; border-radius: 99px; background: #2c2b29; overflow: hidden; }
  .bar span { display: block; height: 100%; background: var(--brand); border-radius: 99px; transition: width 0.6s ease; }
  .c { text-align: right; }
  .filters { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .filters[hidden] { display: none; }
  .filters :global(button) { border: 1.5px solid #4a4844; background: transparent; color: #e7e4dc; border-radius: 999px; padding: 0.35rem 0.8rem; font-size: 0.83rem; font-weight: 600; cursor: pointer; min-height: 36px; }
  .filters :global(button[aria-pressed='true']) { background: var(--brand); color: var(--ink); border-color: var(--brand); }
  .note { margin: 0; font-size: 0.82rem; color: #a9a69e; }

  .grid { columns: 2 300px; column-gap: var(--gap); }
  :global(.rv) { break-inside: avoid; margin-bottom: var(--gap); background: var(--panel); border-radius: 26px; padding: 1.5rem; display: flex; flex-direction: column; gap: 0.9rem; animation: rvIn 0.45s ease both; }
  @keyframes rvIn { from { opacity: 0; transform: translateY(8px); } }
  :global(.rv-top) { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap; }
  :global(.rv .svc) { font-size: 0.78rem; font-weight: 650; padding: 0.25rem 0.65rem; border-radius: 999px; background: var(--panel-2); }
  :global(.rv .txt) { margin: 0; font-size: 1.04rem; white-space: pre-line; overflow-wrap: anywhere; }
  :global(.rv .who) { display: flex; align-items: center; gap: 0.7rem; padding-top: 0.9rem; border-top: 1px solid var(--line); }
  :global(.rv .av) { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; font-weight: 750; font-family: var(--font-head); color: var(--ink); flex: none; }
  :global(.rv .meta) { display: grid; line-height: 1.3; }
  :global(.rv .vb) { margin-left: auto; display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.78rem; font-weight: 700; color: var(--ok); text-align: right; }
  :global(.rv .vb[hidden]) { display: none; }
  :global(.rv time) { font-size: 0.82rem; color: var(--muted); }

  .sk { break-inside: avoid; margin-bottom: var(--gap); background: var(--panel); border-radius: 26px; padding: 1.5rem; display: grid; gap: 0.6rem; }
  .sk span { height: 12px; border-radius: 6px; background: linear-gradient(90deg, #eeebe5, #f7f5f1, #eeebe5); background-size: 200% 100%; animation: sh 1.2s infinite linear; }
  .sk span.short { width: 55%; }
  @keyframes sh { to { background-position: -200% 0; } }
  .empty { text-align: center; display: grid; justify-items: center; gap: 0.25rem; padding-block: 3rem; }
  .empty[hidden] { display: none; }
  .empty h2 { font-size: 1.6rem; }
  .more { margin: 0 auto; display: flex; }
  .more[hidden] { display: none; }

  @media (max-width: 960px) {
    .tm { grid-template-columns: 1fr; }
    .summary { position: static; }
  }
</style>

<script>
  import { getReviews, isConfigured, type Review } from '../lib/supabase';

  const root = document.querySelector<HTMLElement>('[data-reviews]');
  if (root) {
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const grid = q<HTMLDivElement>('[data-grid]');
    const tpl = document.getElementById('review-tpl') as HTMLTemplateElement;
    const more = q<HTMLButtonElement>('[data-more]');
    const filters = q<HTMLDivElement>('[data-filters]');
    const PAGE = 8;
    let all: Review[] = [];
    let current: Review[] = [];
    let shown = 0;

    const STAR = '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2.8l2.8 5.8 6.3.9-4.6 4.4 1.1 6.3L12 17.2l-5.6 3 1.1-6.3L2.9 9.5l6.3-.9z"/></svg>';
    const starsHtml = (n: number, size = 18) =>
      Array.from({ length: 5 }, (_, i) => STAR.replace('width="18" height="18"', `width="${size}" height="${size}"`).replace('<svg', `<svg class="${i < Math.round(n) ? '' : 'off'}"`)).join('');
    const palette = ['#FFC83D', '#F3F1EC', '#E8E6E1', '#FFE39A', '#DCD9D2'];
    const colorFor = (s: string) => palette[[...s].reduce((a, c) => a + c.charCodeAt(0), 0) % palette.length];
    const fmt = (iso: string) => new Date(iso).toLocaleDateString('id-ID', { month: 'long', year: 'numeric' });

    const card = (r: Review) => {
      const n = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
      const stars = n.querySelector('[data-stars]')!;
      stars.innerHTML = starsHtml(r.rating);
      stars.setAttribute('role', 'img');
      stars.setAttribute('aria-label', `${r.rating} dari 5 bintang`);
      n.querySelector('[data-svc]')!.textContent = r.service;
      n.querySelector('[data-txt]')!.textContent = r.comment;
      n.querySelector('[data-name]')!.textContent = r.name;
      const av = n.querySelector<HTMLElement>('[data-av]')!;
      av.textContent = r.name.trim().charAt(0).toUpperCase();
      av.style.background = colorFor(r.name);
      const t = n.querySelector<HTMLTimeElement>('[data-date]')!;
      t.dateTime = r.created_at;
      t.textContent = fmt(r.created_at);
      n.querySelector<HTMLElement>('[data-verified]')!.hidden = r.source !== 'struk';
      return n;
    };

    const renderPage = (reset = false) => {
      if (reset) { grid.innerHTML = ''; shown = 0; }
      const next = current.slice(shown, shown + PAGE);
      const frag = document.createDocumentFragment();
      next.forEach((r) => frag.appendChild(card(r)));
      grid.appendChild(frag);
      shown += next.length;
      more.hidden = shown >= current.length;
    };

    const summary = (list: Review[]) => {
      const total = list.length;
      const avg = total ? list.reduce((a, r) => a + r.rating, 0) / total : 0;
      q('[data-avg]').textContent = total ? avg.toFixed(1).replace('.', ',') : '';
      q('[data-avg]').toggleAttribute('hidden', !total);
      q('[data-avg-stars]').innerHTML = starsHtml(avg, 22);
      q('[data-count]').textContent = total ? `${total} ulasan terverifikasi` : 'Belum ada ulasan';
      [1, 2, 3, 4, 5].forEach((s) => {
        const c = list.filter((r) => r.rating === s).length;
        q<HTMLElement>(`[data-bar="${s}"]`).style.width = total ? `${(c / total) * 100}%` : '0%';
        q(`[data-bar-count="${s}"]`).textContent = String(c);
      });
      // rating di hero
      const hero = document.querySelector<HTMLElement>('[data-hero-rating]');
      if (hero && total) {
        hero.hidden = false;
        hero.querySelector('[data-hero-avg]')!.textContent = avg.toFixed(1).replace('.', ',');
        hero.querySelector('[data-hero-count]')!.textContent = String(total);
      }
    };

    const buildFilters = () => {
      const services = [...new Set(all.map((r) => r.service))];
      if (services.length < 2) return;
      filters.hidden = false;
      const mk = (label: string, value: string | null) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = label;
        b.setAttribute('aria-pressed', String(value === null));
        b.addEventListener('click', () => {
          filters.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', 'false'));
          b.setAttribute('aria-pressed', 'true');
          current = value ? all.filter((r) => r.service === value) : all;
          renderPage(true);
        });
        filters.appendChild(b);
      };
      mk('Semua', null);
      services.forEach((s) => mk(s, s));
    };

    const load = async () => {
      q('[data-error]').toggleAttribute('hidden', true);
      try {
        if (!isConfigured) throw new Error('not configured');
        all = await getReviews();
        current = all;
        summary(all);
        if (!all.length) {
          grid.innerHTML = '';
          q('[data-empty]').toggleAttribute('hidden', false);
        } else {
          buildFilters();
          renderPage(true);
        }
      } catch (err) {
        console.warn('[PAS] gagal memuat ulasan', err);
        grid.innerHTML = '';
        q('[data-count]').textContent = 'Ulasan belum dapat dimuat';
        q('[data-error]').toggleAttribute('hidden', false);
      } finally {
        root.setAttribute('aria-busy', 'false');
      }
    };

    more.addEventListener('click', () => renderPage());
    q('[data-retry]').addEventListener('click', load);

    // muat saat bagian testimoni mendekati layar, agar halaman awal tetap ringan
    let started = false;
    const start = () => { if (started) return; started = true; load(); };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((e) => { if (e.some((x) => x.isIntersecting)) { io.disconnect(); start(); } }, { rootMargin: '600px 0px' });
      io.observe(root);
      // tetap muat setelah halaman siap, supaya rating di hero ikut tampil
      const later = () => setTimeout(() => { io.disconnect(); start(); }, 800);
      if (document.readyState === 'complete') later(); else window.addEventListener('load', later, { once: true });
    } else {
      start();
    }
  }
</script>
