---
// Header halaman ala gambar 3: tombol tutup bulat + judul seperti tab + sub-navigasi pill
import Icon from './Icon.astro';

interface Sub { href: string; label: string; icon?: string; count?: string | number }
interface Props { kicker?: string; title: string; desc?: string; subnav?: Sub[]; subLabel?: string }
const { kicker, title, desc, subnav = [], subLabel = 'Bagian halaman' } = Astro.props;
---

<section class="panel phead">
  <div class="top">
    <a class="close round" href="/" aria-label="Tutup, kembali ke beranda"><Icon name="close" size={20} /></a>
    <div class="ttl">
      {kicker && <p class="kicker">{kicker}</p>}
      <h1>{title}</h1>
    </div>
    <div class="right"><slot name="right" /></div>
  </div>
  {desc && <p class="muted desc">{desc}</p>}
  {subnav.length > 0 && (
    <nav class="sub" aria-label={subLabel}>
      {subnav.map((s, i) => (
        <a href={s.href} class:list={['sp', { first: i === 0 }]} data-sub>
          {s.icon && <Icon name={s.icon} size={16} />}
          <span>{s.label}</span>
          {s.count !== undefined && <em>{s.count}</em>}
        </a>
      ))}
    </nav>
  )}
  <slot />
</section>

<style>
  .phead { display: grid; gap: 1rem; }
  .top { display: flex; align-items: center; gap: 1rem; }
  .close { flex: none; width: 52px; height: 52px; background: var(--panel-2); color: var(--ink); }
  .close:hover { background: var(--ink); color: #fff; }
  .ttl { min-width: 0; }
  .ttl .kicker { margin-bottom: 0.25rem; }
  h1 { margin: 0; font-size: clamp(2rem, 4.6vw, 3.6rem); }
  .right { margin-left: auto; }
  .desc { margin: 0; font-size: 1.05rem; max-width: 62ch; }
  .sub { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .sp {
    display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.5rem 0.95rem; border-radius: 999px; background: var(--panel-2);
    text-decoration: none; font-weight: 600; font-size: 0.88rem; color: var(--ink-2); transition: background-color 0.18s ease, color 0.18s ease;
  }
  .sp:hover, .sp.is-on { background: var(--ink); color: #fff; }
  .sp em { font-style: normal; font-size: 0.75rem; padding: 0.05rem 0.45rem; border-radius: 99px; background: rgb(0 0 0 / 0.07); }
  .sp:hover em, .sp.is-on em { background: rgb(255 255 255 / 0.18); }
  @media (max-width: 640px) {
    .close { width: 44px; height: 44px; }
    .top { gap: 0.75rem; }
    h1 { font-size: clamp(1.7rem, 7.6vw, 2.2rem); }
    .sub { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-inline: -0.25rem; padding: 0.1rem 0.25rem; }
    .sp { flex: none; }
  }
</style>

<script>
  // Sorot sub-pill sesuai bagian yang sedang terlihat (scroll-spy ringan)
  const subs = [...document.querySelectorAll<HTMLAnchorElement>('[data-sub][href^="#"]')];
  const targets = subs.map((a) => document.querySelector<HTMLElement>(a.getAttribute('href')!)).filter(Boolean) as HTMLElement[];
  if (targets.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          subs.forEach((a) => a.classList.toggle('is-on', a.getAttribute('href') === '#' + e.target.id));
        });
      },
      { rootMargin: '-35% 0px -55% 0px' },
    );
    targets.forEach((t) => io.observe(t));
  }
</script>
