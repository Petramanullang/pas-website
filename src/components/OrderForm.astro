---
import Icon from './Icon.astro';
import { SERVICES, LANGUAGES, CONTACT, WA_GENERAL } from '../config';
---

<div class="order">
  <aside class="panel panel--dark side">
    <p class="kicker">Pesan sekarang</p>
    <h1>Ceritakan kebutuhanmu, sisanya kita diskusikan.</h1>
    <p class="muted">Isi form, tekan <strong>Kirim via WhatsApp</strong>, dan pesanmu tersusun otomatis. Kamu tinggal menekan kirim.</p>
    <ul class="checks">
      <li><Icon name="check" size={18} /><span>Gratis tanya-tanya dulu, tanpa kewajiban order</span></li>
      <li><Icon name="check" size={18} /><span>Harga final disepakati sebelum mulai</span></li>
      <li><Icon name="check" size={18} /><span>Dapat struk untuk cek status dan menulis ulasan</span></li>
    </ul>
    <div class="direct">
      <span class="muted">Lebih suka langsung chat?</span>
      <a class="phone" href={WA_GENERAL} target="_blank" rel="noopener"><Icon name="wa" size={22} /> {CONTACT.phoneDisplay}</a>
    </div>
  </aside>

  <form class="panel form" id="order-form" novalidate>
      <div class="field">
        <label for="f-service">Layanan <span class="req" aria-hidden="true">*</span></label>
        <select class="select" id="f-service" name="service" required>
          <option value="" disabled selected>Pilih layanan…</option>
          {SERVICES.map((s) => <option value={s.id}>{s.title}</option>)}
        </select>
        <p class="error" id="e-service" hidden>Pilih layanan dulu, ya.</p>
      </div>

      <div class="row2">
        <div class="field">
          <label for="f-name">Nama <span class="req" aria-hidden="true">*</span></label>
          <input class="input" id="f-name" name="name" type="text" autocomplete="name" placeholder="Nama kamu" required maxlength="60" />
          <p class="error" id="e-name" hidden>Nama minimal 2 karakter.</p>
        </div>
        <div class="field">
          <label for="f-phone">Nomor WhatsApp <span class="req" aria-hidden="true">*</span></label>
          <input class="input" id="f-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="20" placeholder="0812 3456 7890" required />
          <p class="hint" data-phone-hint>Untuk membuka struk pesananmu.</p>
          <p class="error" id="e-phone" hidden>Tulis nomor WhatsApp yang aktif, misal 0812 3456 7890.</p>
        </div>
      </div>

      <div class="field" data-when="tugas" hidden>
        <label for="f-course">Mata kuliah / topik</label>
        <input class="input" id="f-course" name="course" type="text" placeholder="Contoh: Basis Data, Pengantar Akuntansi" maxlength="80" />
      </div>

      <div class="row2" data-when="kelas" hidden>
        <div class="field">
          <label for="f-lang">Mau belajar apa?</label>
          <select class="select" id="f-lang" name="lang">
            {LANGUAGES.map((l) => <option value={l}>{l}</option>)}
            <option value="Belum tahu, minta saran">Belum tahu, minta saran</option>
          </select>
        </div>
        <fieldset class="field mode">
          <legend class="label">Mode kelas</legend>
          <div class="seg">
            <label><input type="radio" name="mode" value="Online" checked /> <span>Online</span></label>
            <label><input type="radio" name="mode" value="Offline" /> <span>Offline</span></label>
          </div>
        </fieldset>
      </div>

      <div class="field">
        <label for="f-detail">Detail kebutuhan <span class="req" aria-hidden="true">*</span></label>
        <textarea class="textarea" id="f-detail" name="detail" required maxlength="800" placeholder="Ceritakan singkat apa yang kamu butuhkan…"></textarea>
        <p class="error" id="e-detail" hidden>Tulis detail minimal 10 karakter supaya bisa diperkirakan.</p>
      </div>

      <div class="row2">
        <div class="field">
          <label for="f-deadline" data-deadline-label>Deadline</label>
          <input class="input" id="f-deadline" name="deadline" type="date" />
        </div>
        <div class="field">
          <label for="f-budget">Budget <span class="opt">(opsional)</span></label>
          <input class="input" id="f-budget" name="budget" type="text" inputmode="text" placeholder="Contoh: Rp100rb" maxlength="40" />
        </div>
      </div>

      <div class="field promo">
        <label for="f-promo">Kode promo <span class="opt">(opsional)</span></label>
        <div class="promo-row">
          <input class="input code" id="f-promo" name="promo" type="text" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="24" placeholder="Contoh: HEMAT20" aria-describedby="promo-msg" />
          <button class="btn btn--light promo-btn" type="button" data-promo-apply>Pakai</button>
        </div>
        <div class="promo-msg" id="promo-msg" role="status" aria-live="polite" data-promo-msg hidden></div>
      </div>

      <button class="btn btn--wa btn--block submit" type="submit">
        <Icon name="wa" /> Kirim via WhatsApp
      </button>
      <p class="status" role="status" aria-live="polite" data-status></p>
      <p class="mine">Sudah pernah pesan? <a href="/pesananku">Lihat struk di Pesananku</a></p>
    </form>
</div>

<style>
  .order { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: var(--gap); align-items: stretch; }
  .side { display: flex; flex-direction: column; gap: 1.1rem; }
  .side h1 { color: #fff; font-size: clamp(2rem, 3.6vw, 3rem); margin: 0; }
  .side p { margin: 0; }
  .direct { margin-top: auto; padding-top: 1.25rem; border-top: 1px solid var(--line-dark); display: grid; gap: 0.3rem; }
  .phone { display: inline-flex; align-items: center; gap: 0.55rem; font-family: var(--font-head); font-weight: 800; font-size: 1.7rem; color: var(--brand); text-decoration: none; }

  .form { display: grid; gap: 1.15rem; align-content: start; }
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .row2[hidden], .field[hidden] { display: none; }
  .mode { border: 0; padding: 0; margin: 0; min-width: 0; }
  .mode legend { margin-bottom: 0.4rem; padding: 0; }
  .seg { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; padding: 4px; border-radius: 16px; background: var(--panel-2); min-height: 50px; }
  .seg label { position: relative; display: grid; place-items: center; border-radius: 12px; cursor: pointer; font-weight: 600; font-size: 0.95rem; }
  .seg input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .seg label:has(input:checked) { background: var(--ink); color: #fff; }
  .seg label:has(input:focus-visible) { outline: 3px solid var(--brand-deep); outline-offset: 2px; }
  .promo-row { display: grid; grid-template-columns: 1fr auto; gap: 0.5rem; }
  .promo-row .code { text-transform: uppercase; letter-spacing: 0.06em; font-weight: 650; }
  .promo-row .code::placeholder { letter-spacing: 0.04em; font-weight: 400; text-transform: none; }
  .promo-btn { border: 1.5px solid var(--line); min-height: 50px; }
  .promo-msg { border-radius: 16px; padding: 0.85rem 1rem; font-size: 0.92rem; display: grid; gap: 0.2rem; }
  .promo-msg[hidden] { display: none; }
  .promo-msg.ok { background: #fff3d1; }
  .promo-msg.bad { background: #fbe6e3; color: var(--err); font-weight: 600; }
  .promo-msg :global(strong) { font-family: var(--font-head); font-size: 1.05rem; }
  .promo-msg :global(.est) { color: var(--ink-2); }
  .promo-msg :global(.est s) { color: var(--muted); }
  .promo-msg :global(.fine) { font-size: 0.82rem; color: var(--muted); }
  .hint { margin: 0; font-size: 0.82rem; color: var(--muted); }
  .promo-msg :global(.cond) { font-size: 0.85rem; color: var(--ink-2); }
  .promo-msg :global(button) { justify-self: start; border: 0; background: none; padding: 0; font-weight: 600; text-decoration: underline; cursor: pointer; font-size: 0.85rem; color: var(--ink-2); }
  .submit { min-height: 56px; font-size: 1.02rem; margin-top: 0.25rem; }
  .status { margin: 0; font-size: 0.92rem; color: var(--muted); min-height: 1.4em; }
  .status :global(a) { font-weight: 650; }
  .status.ok { color: var(--ink); background: #e6f5ec; border-radius: 16px; padding: 0.85rem 1rem; display: grid; gap: 0.35rem; }
  .status.ok :global(strong) { font-family: var(--font-head); font-size: 1.05rem; }
  .status.ok :global(.code) { font-family: ui-monospace, 'SFMono-Regular', Consolas, monospace; font-weight: 800; letter-spacing: 0.04em; }
  .status.bad { color: var(--err); font-weight: 600; }
  .mine { margin: 0; font-size: 0.88rem; color: var(--muted); text-align: center; }
  .mine a { font-weight: 650; color: var(--ink); }
  @media (max-width: 900px) { .order { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .row2 { grid-template-columns: 1fr; } }
</style>

<script>
  import { SERVICES, waLink } from '../config';
  import { checkPromo, createOrder, promoLabel, applyPromo, rupiah, daysLabel, timeLabel, type PromoCheck } from '../lib/supabase';
  import { saveStruk, getOrderRef, resetOrderRef, normPhone } from '../lib/struk';

  const form = document.getElementById('order-form') as HTMLFormElement | null;
  if (form) {
    const $ = <T extends HTMLElement>(sel: string) => form.querySelector<T>(sel)!;
    const service = $<HTMLSelectElement>('#f-service');
    const name = $<HTMLInputElement>('#f-name');
    const detail = $<HTMLTextAreaElement>('#f-detail');
    const deadline = $<HTMLInputElement>('#f-deadline');
    const deadlineLabel = $<HTMLLabelElement>('[data-deadline-label]');
    const status = $<HTMLParagraphElement>('[data-status]');

    const placeholders: Record<string, string> = {
      tugas: 'Contoh: laporan praktikum modul 3, 10 halaman, format dari dosen sudah ada.',
      website: 'Contoh: website portofolio 3 halaman untuk melamar kerja, sudah punya CV.',
      uiux: 'Contoh: desain 5 halaman aplikasi kasir di Figma untuk tugas akhir.',
      kelas: 'Contoh: pemula total, ingin bisa bikin website sendiri dalam sebulan.',
      lainnya: 'Ceritakan kebutuhanmu, nanti kita diskusikan apakah bisa dibantu.',
    };

    // tanggal minimal = hari ini
    const today = new Date();
    deadline.min = new Date(today.getTime() - today.getTimezoneOffset() * 60000).toISOString().slice(0, 10);

    const sync = () => {
      const v = service.value;
      form.querySelectorAll<HTMLElement>('[data-when]').forEach((el) => (el.hidden = el.dataset.when !== v));
      detail.placeholder = placeholders[v] ?? 'Ceritakan singkat apa yang kamu butuhkan…';
      deadlineLabel.textContent = v === 'kelas' ? 'Mau mulai kapan?' : 'Deadline';
    };
    service.addEventListener('change', () => { sync(); setErr('service', false); if (promoCode) applyCode(promoCode, true); });

    // ---------- kode promo ----------
    const promoInput = $<HTMLInputElement>('#f-promo');
    const promoBtn = $<HTMLButtonElement>('[data-promo-apply]');
    const promoMsg = $<HTMLDivElement>('[data-promo-msg]');
    const phone = $<HTMLInputElement>('#f-phone');
    const phoneHint = $<HTMLParagraphElement>('[data-phone-hint]');
    const phoneOk = (v: string) => /^(\+?62|0)?8[0-9]{7,12}$/.test(v.replace(/[\s.-]/g, ''));
    const modeVal = () => form.querySelector<HTMLInputElement>('input[name="mode"]:checked')?.value ?? '';
    const promoMode = () => (service.value === 'kelas' ? modeVal() : '');
    const syncPhone = () => {
      const lim = promo?.per_person_limit ?? null;
      phoneHint.textContent = lim
        ? `Untuk membuka struk. Promo ini bisa dipakai ${lim === 1 ? 'satu kali' : `${lim} kali`} per nomor.`
        : 'Untuk membuka struk pesananmu.';
    };
    phone.addEventListener('input', () => { if (phoneOk(phone.value)) setErr('phone', false); });
    let promo: Extract<PromoCheck, { status: 'ok' }> | null = null;
    let promoCode = '';
    let usedLine = ''; // dipakai ulang bila form dikirim lagi tanpa perubahan
    let lastSig = '', lastCode = '';
    const fmtD = (iso: string) => new Date(iso).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
    const svcTitle = (id: string) => SERVICES.find((s) => s.id === id)?.title ?? id;
    const basePrice = () => {
      const svc = SERVICES.find((s) => s.id === service.value);
      if (!svc || svc.from === null) return null;
      if (svc.id === 'kelas') return modeVal() === 'Offline' ? 80000 : 50000;
      return svc.from;
    };
    const showPromo = (html: string, kind: 'ok' | 'bad') => {
      promoMsg.innerHTML = html;
      promoMsg.className = `promo-msg ${kind}`;
      promoMsg.hidden = false;
    };
    const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const renderPromo = () => {
      syncPhone();
      if (!promo) return;
      const base = basePrice();
      let est = '';
      if (base !== null) {
        const { price } = applyPromo(promo, base);
        est = `<span class="est">Perkiraan: <s>mulai ${rupiah(base)}</s> → mulai <b>${rupiah(price)}</b></span>`;
      }
      const until = promo.ends_at ? ` · berlaku s.d. ${fmtD(promo.ends_at)}` : '';
      const cond = [daysLabel(promo.days), timeLabel(promo.time_start, promo.time_end), promo.class_mode ? `kelas ${promo.class_mode.toLowerCase()}` : '']
        .filter(Boolean).join(' · ');
      showPromo(
        `<strong>${esc(promo.code)} · ${esc(promoLabel(promo))}</strong>${promo.title ? `<span>${esc(promo.title)}</span>` : ''}${est}` +
        (cond ? `<span class="cond">Berlaku: ${esc(cond)}</span>` : '') +
        `<span class="fine">Potongan dihitung dari harga final yang disepakati${until}.</span><button type="button" data-promo-remove>Hapus kode</button>`,
        'ok',
      );
      promoMsg.querySelector('[data-promo-remove]')!.addEventListener('click', clearPromo);
    };
    function clearPromo() {
      usedLine = '';
      promo = null; promoCode = ''; promoInput.value = ''; promoMsg.hidden = true; syncPhone(); promoInput.focus();
    }
    async function applyCode(raw: string, silent = false) {
      const code = raw.toUpperCase().replace(/[^A-Z0-9-]/g, '');
      promoInput.value = code;
      if (code !== promoCode) usedLine = '';
      if (!code) { promo = null; promoCode = ''; promoMsg.hidden = true; syncPhone(); return; }
      if (!service.value) { showPromo('Pilih layanan dulu, lalu pakai kode promonya.', 'bad'); return; }
      promoBtn.disabled = true; promoBtn.textContent = 'Cek…';
      try {
        const r = await checkPromo(code, service.value, promoMode());
        promoCode = code;
        if (r.status === 'ok') { promo = r; renderPromo(); return; }
        promo = null; usedLine = ''; syncPhone();
        const msg =
          r.status === 'invalid' ? 'Kode promo tidak ditemukan.' :
          r.status === 'not_started' ? `Promo ini belum dimulai${r.starts_at ? ` (mulai ${fmtD(r.starts_at)})` : ''}.` :
          r.status === 'expired' ? 'Promo ini sudah berakhir.' :
          r.status === 'quota' ? (r.personal ? 'Kode personal ini sudah dipakai.' : 'Kuota promo ini sudah habis.') :
          r.status === 'mode' ? `Promo ini khusus kelas ${r.class_mode?.toLowerCase()}. Ganti mode kelas kalau mau memakainya.` :
          r.status === 'day' ? `Promo ini hanya berlaku hari ${daysLabel(r.days)}.` :
          r.status === 'time' ? `Promo ini hanya berlaku jam ${timeLabel(r.time_start, r.time_end)}.` :
          `Promo ini hanya untuk: ${r.services.map(svcTitle).join(', ')}.`;
        showPromo(esc(msg), 'bad');
      } catch {
        if (!silent) showPromo('Tidak bisa memeriksa kode sekarang. Coba lagi sebentar.', 'bad');
      } finally {
        promoBtn.disabled = false; promoBtn.textContent = 'Pakai';
      }
    }
    promoBtn.addEventListener('click', () => applyCode(promoInput.value));
    promoInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); applyCode(promoInput.value); } });
    form.querySelectorAll('input[name="mode"]').forEach((r) =>
      r.addEventListener('change', () => (promoCode ? applyCode(promoCode, true) : renderPromo())),
    );
    const promoFromUrl = new URLSearchParams(location.search).get('promo');
    if (promoFromUrl) { promoInput.value = promoFromUrl; }

    // tombol "Pesan" di kartu layanan memilih layanan otomatis
    document.querySelectorAll<HTMLAnchorElement>('[data-pick]').forEach((a) =>
      a.addEventListener('click', () => {
        service.value = a.dataset.pick ?? '';
        sync();
        setTimeout(() => name.focus({ preventScroll: true }), 450);
      }),
    );
    const fromUrl = new URLSearchParams(location.search).get('layanan');
    if (fromUrl && SERVICES.some((s) => s.id === fromUrl)) { service.value = fromUrl; }
    sync();
    if (promoFromUrl && service.value) applyCode(promoFromUrl, true);

    function setErr(key: 'service' | 'name' | 'detail' | 'phone', on: boolean) {
      const input = { service, name, detail, phone }[key];
      const msg = form!.querySelector<HTMLElement>(`#e-${key}`)!;
      msg.hidden = !on;
      input.setAttribute('aria-invalid', String(on));
      if (on) input.setAttribute('aria-describedby', `e-${key}`); else input.removeAttribute('aria-describedby');
    }
    name.addEventListener('input', () => name.value.trim().length >= 2 && setErr('name', false));
    detail.addEventListener('input', () => detail.value.trim().length >= 10 && setErr('detail', false));

    const fmtDate = (v: string) =>
      new Date(v + 'T00:00:00').toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });

    let busy = false;
    const submitBtn = $<HTMLButtonElement>('button[type="submit"]');
    const setStatus = (html: string, kind: '' | 'ok' | 'bad' = '') => { status.innerHTML = html; status.className = `status${kind ? ' ' + kind : ''}`; };
    const promoMsgFor = (st: string) =>
      st === 'person_limit' ? 'Nomor ini sudah memakai promo ini sampai batasnya. Hapus kode untuk lanjut tanpa promo.' :
      st === 'quota' ? 'Kuota promo ini baru saja habis. Hapus kode untuk lanjut tanpa promo.' :
      st === 'expired' ? 'Promo ini sudah berakhir.' :
      st === 'day' || st === 'time' ? 'Promo ini sedang di luar jadwal berlakunya.' :
      'Kode promo tidak bisa dipakai. Hapus kode atau coba kode lain.';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (busy) return;
      const errs = {
        service: !service.value,
        name: name.value.trim().length < 2,
        phone: !phoneOk(phone.value),
        detail: detail.value.trim().length < 10,
      };
      (Object.keys(errs) as (keyof typeof errs)[]).forEach((k) => setErr(k, errs[k]));
      const first = (['service', 'name', 'phone', 'detail'] as const).find((k) => errs[k]);
      if (first) {
        ({ service, name, phone, detail })[first].focus();
        setStatus('Ada isian yang belum lengkap.', 'bad');
        return;
      }
      if (promoInput.value.trim() && !promo) {
        promoInput.focus();
        setStatus('Kode promo belum valid. Tekan "Pakai" atau kosongkan kolomnya.', 'bad');
        return;
      }

      const fd0 = new FormData(form);
      const extra: Record<string, string> = {};
      const svcId = service.value;
      if (svcId === 'tugas' && String(fd0.get('course') || '').trim()) extra.course = String(fd0.get('course')).trim().slice(0, 80);
      if (svcId === 'kelas') { extra.lang = String(fd0.get('lang') || ''); extra.mode = String(fd0.get('mode') || ''); }
      if (deadline.value) extra.deadline = deadline.value;
      if (String(fd0.get('budget') || '').trim()) extra.budget = String(fd0.get('budget')).trim().slice(0, 40);
      const sig = JSON.stringify([svcId, name.value.trim(), phone.value.replace(/\D/g, ''), detail.value.trim(), extra, promo?.code ?? '']);

      // buka tab dulu (masih dalam klik pengguna) supaya tidak diblokir browser
      const win = window.open('', '_blank');
      let promoLine = '';
      let code = '';
      if (sig === lastSig && lastCode) {
        code = lastCode; promoLine = usedLine; // kirim ulang pesan yang sama: tidak membuat struk baru
      } else {
        busy = true; submitBtn.disabled = true;
        setStatus('Membuat struk pesanan…');
        const base = basePrice();
        const est = base !== null ? (promo ? applyPromo(promo, base).price : base) : null;
        try {
          const r = await createOrder({
            name: name.value.trim(), phone: phone.value, service: svcId, detail: detail.value.trim(), extra,
            estPrice: est, promo: promo?.code ?? null, clientRef: getOrderRef(),
          });
          if (r.status === 'ok') {
            code = r.code;
            resetOrderRef();
            if (promo) promoLine = `• Kode promo: ${promo.code}, ${promoLabel(promo)}${base !== null ? `, perkiraan mulai ${rupiah(est!)}` : ''}`;
            saveStruk({
              code, phone: normPhone(phone.value), name: name.value.trim(), service: svcId,
              detail: detail.value.trim(), extra, estPrice: est, finalPrice: null,
              promo: promo ? { code: promo.code, discount_type: promo.discount_type, value: promo.value, max_discount: promo.max_discount } : null,
              status: 'menunggu', reviewed: false, createdAt: r.created_at, checkedAt: Date.now(),
            });
            lastSig = sig; lastCode = code; usedLine = promoLine;
          } else if (r.status === 'promo') {
            win?.close();
            if (r.promo_status === 'need_phone') { setErr('phone', true); phone.focus(); }
            setStatus(esc(promoMsgFor(r.promo_status)), 'bad');
            if (!['person_limit', 'need_phone'].includes(r.promo_status)) await applyCode(promoInput.value, true);
            return;
          } else if (promo) {
            // promo wajib tercatat, jadi pesanan dengan promo tidak dikirim tanpa struk
            win?.close();
            setStatus(r.status === 'rate_limit'
              ? 'Nomor ini sudah membuat 5 pesanan dalam 1 jam terakhir. Coba lagi nanti atau hubungi lewat chat.'
              : r.status === 'busy' ? 'Server sedang ramai. Coba lagi beberapa menit lagi.'
              : esc(r.message), 'bad');
            return;
          }
          // tanpa promo: tetap lanjut ke WhatsApp walau struk gagal dibuat
        } catch {
          if (promo) {
            win?.close();
            setStatus('Gagal membuat struk. Periksa koneksi lalu coba lagi.', 'bad');
            return;
          }
        } finally {
          busy = false; submitBtn.disabled = false;
        }
      }

      const fd = new FormData(form);
      const svc = SERVICES.find((s) => s.id === service.value)!;
      const lines = [
        'Halo Kak Petra, saya mau pesan lewat website PAS.',
        '',
        `• Nama: ${name.value.trim()}`,
        `• Layanan: ${svc.title}`,
      ];
      if (svc.id === 'tugas' && String(fd.get('course') || '').trim()) lines.push(`• Mata kuliah/topik: ${String(fd.get('course')).trim()}`);
      if (svc.id === 'kelas') {
        lines.push(`• Materi: ${fd.get('lang')}`);
        lines.push(`• Mode: ${fd.get('mode')}`);
      }
      lines.push(`• Detail: ${detail.value.trim()}`);
      if (deadline.value) lines.push(`• ${svc.id === 'kelas' ? 'Mulai' : 'Deadline'}: ${fmtDate(deadline.value)}`);
      const budget = String(fd.get('budget') || '').trim();
      if (budget) lines.push(`• Budget: ${budget}`);
      if (promoLine) lines.push(promoLine);
      if (code) lines.push(`• Kode struk: ${code}`);
      lines.push('', 'Terima kasih!');

      const url = waLink(lines.join('\n'));
      if (win) { win.opener = null; win.location.href = url; }
      const waLine = win
        ? `WhatsApp sudah dibuka di tab baru. Tidak muncul? <a href="${url}" target="_blank" rel="noopener">Buka di sini</a>.`
        : `Mengalihkan ke WhatsApp… <a href="${url}">Klik di sini</a> jika tidak berpindah.`;
      if (code) {
        setStatus(
          `<strong>Struk dibuat: <span class="code">${esc(code)}</span></strong>` +
          `<span>Simpan kodenya. Status pesanan dan tombol ulasan ada di <a href="/struk?kode=${encodeURIComponent(code)}">struk ini</a>.</span>` +
          `<span>${waLine}</span>`, 'ok');
      } else {
        setStatus(`${waLine} Struk belum bisa dibuat sekarang, pesananmu tetap terkirim lewat WhatsApp.`);
      }
      if (!win) setTimeout(() => (location.href = url), code ? 1200 : 0);
    });
  }
</script>
